.tabbar-wrap { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #e6edf5; z-index: 999; }
.tabbar { height: 108rpx; display: flex; padding-bottom: env(safe-area-inset-bottom); }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6f87a3; }
.tab-item.active { color: #2f7ac9; }
.icon { font-size: 38rpx; line-height: 1; margin-bottom: 6rpx; }
.label { font-size: 22rpx; }
