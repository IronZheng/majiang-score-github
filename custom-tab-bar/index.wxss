.tabbar-wrap { position: fixed; left: 0; right: 0; bottom: 0; background: #fff; border-top: 1rpx solid #e6edf5; z-index: 999; }
.tabbar { height: 108rpx; display: flex; padding-bottom: env(safe-area-inset-bottom); }
.tab-item { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #6f87a3; position: relative; }
.tab-item.active { color: #2f7ac9; background: #e8f4ff; }
.icon { font-size: 38rpx; line-height: 1; margin-bottom: 4rpx; }
.tab-item.active .icon { font-size: 44rpx; }
.label { font-size: 22rpx; }
.active-bar { position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 40rpx; height: 4rpx; background: #2f7ac9; border-radius: 0 0 4rpx 4rpx; }
