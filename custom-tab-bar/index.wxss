.tabbar-wrap {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 20rpx;
  z-index: 999;
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar {
  height: 104rpx;
  display: flex;
  padding: 10rpx;
  background: rgba(255, 255, 255, 0.94);
  border: 1rpx solid rgba(228, 155, 115, 0.11);
  border-radius: 28rpx;
  box-shadow: 0 18rpx 42rpx rgba(228, 155, 115, 0.13);
  box-sizing: border-box;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8b95a5;
  position: relative;
  border-radius: 22rpx;
}

.tab-item.active {
  color: #e49b73;
  background: #fff4ee;
}

.icon {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 4rpx;
}

.tab-item.active .icon {
  width: 44rpx;
  height: 44rpx;
}

.label {
  font-size: 24rpx;
  font-weight: 600;
}

.active-bar {
  display: none;
}
