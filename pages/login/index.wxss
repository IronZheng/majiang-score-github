page {
  background: #fffaf6;
  min-height: 100vh;
}

.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 0 42rpx;
  box-sizing: border-box;
}

.hero-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 112rpx;
  padding-bottom: 56rpx;
}

.majiang-icon {
  width: 128rpx;
  height: 128rpx;
  line-height: 128rpx;
  text-align: center;
  font-size: 72rpx;
  border-radius: 34rpx;
  background: #e49b73;
  margin-bottom: 28rpx;
  box-shadow: 0 18rpx 40rpx rgba(228, 155, 115, 0.20);
}

.app-title {
  font-size: 50rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 14rpx;
}

.app-subtitle {
  font-size: 28rpx;
  color: #8b95a5;
}

.login-card {
  width: 100%;
  position: relative;
  border-radius: 28rpx;
  overflow: hidden;
  max-width: 580rpx;
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.11);
  box-shadow: 0 18rpx 46rpx rgba(228, 155, 115, 0.11);
}

.card-bg {
  display: none;
}

.card-content {
  position: relative;
  padding: 44rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1;
}

.feature-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.profile-preview {
  width: 100%;
  min-height: 112rpx;
  border-radius: 20rpx;
  background: #fffaf6;
  border: 1rpx solid #f1e7de;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.preview-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid #f0d9cb;
  flex-shrink: 0;
}

.preview-info {
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.preview-label {
  font-size: 24rpx;
  color: #a18b7d;
}

.preview-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feature-list {
  width: 100%;
  margin-bottom: 38rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.feature-item:last-child {
  margin-bottom: 0;
}

.feature-icon {
  width: 40rpx;
  height: 40rpx;
  background: #e49b73;
  color: #ffffff;
  border-radius: 50%;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.feature-text {
  font-size: 30rpx;
  color: #4b5563;
}

.login-btn {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  background: #e49b73;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(228, 155, 115, 0.22);
  border: none;
  text-align: center;
  padding: 0;
  margin: 0;
}

.login-btn::after {
  border: none;
}

.login-btn-hover {
  opacity: 0.86;
  transform: scale(0.98);
}

.login-btn[disabled] {
  opacity: 0.65;
}

.footer-tip {
  margin-top: auto;
  padding-bottom: 60rpx;
}

.tip-text {
  font-size: 24rpx;
  color: #a1a8b3;
}

.manual-hint {
  font-size: 26rpx;
  color: #8b95a5;
  text-align: center;
  margin-bottom: 30rpx;
  line-height: 1.6;
  padding: 0 20rpx;
}

.phone-input-wrap {
  width: 100%;
  margin-bottom: 30rpx;
}

.phone-input {
  width: 100%;
  height: 88rpx;
  background: #fffaf6;
  border-radius: 16rpx;
  border: 1rpx solid #e5e7eb;
  font-size: 34rpx;
  color: #1f2937;
  text-align: center;
  letter-spacing: 4rpx;
  box-sizing: border-box;
}

.phone-placeholder {
  color: #b6beca;
  font-size: 32rpx;
}

.submit-btn {
  margin-bottom: 24rpx;
}

.manual-skip {
  font-size: 28rpx;
  color: #6b7280;
  padding: 12rpx 24rpx;
}
