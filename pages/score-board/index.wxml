<view class="container" wx:if="{{game}}">
  <view class="card header-card">
    <view class="round">当前回合：第 {{game.currentRound}} 回合</view>
    <view class="players-grid">
      <block wx:for="{{game.players}}" wx:key="id" wx:for-item="player" wx:for-index="pIndex">
        <view class="player-chip {{activeIndex===pIndex?'active':''}}" data-index="{{pIndex}}" bindtap="selectPlayer">
          <view class="avatar">
            <image class="avatar-img" src="{{player.avatarUrl || avatars[pIndex % avatars.length]}}" mode="aspectFill"></image>
          </view>
          <text class="name">{{player.name}}</text>
          <text class="score">{{player.score}}分</text>
        </view>
      </block>
    </view>
  </view>

  <view class="card action-card">
    <view class="title">给 {{game.players[activeIndex].name}} 加减分</view>
    <view class="score-section">
      <view class="section-label plus-label">加分</view>
      <view class="ops">
        <block wx:for="{{plusDeltas}}" wx:key="*this">
          <view class="score-btn plus" data-delta="{{item}}" bindtap="applyDelta">+{{item}}</view>
        </block>
      </view>
    </view>
    <view class="score-section">
      <view class="section-label minus-label">减分</view>
      <view class="ops">
        <block wx:for="{{minusDeltas}}" wx:key="*this">
          <view class="score-btn minus" data-delta="{{item}}" bindtap="applyDelta">{{item}}</view>
        </block>
      </view>
    </view>
    <view class="custom-row">
      <view class="sign-switch">
        <view class="sign-btn {{customSign===1?'active plus-active':''}}" data-sign="1" bindtap="switchCustomSign">+</view>
        <view class="sign-btn {{customSign===-1?'active minus-active':''}}" data-sign="-1" bindtap="switchCustomSign">-</view>
      </view>
      <input class="custom-input" type="number" value="{{customDelta}}" bindinput="onCustomInput" placeholder="输入分值" />
      <view class="primary-btn confirm-btn" bindtap="applyCustom">确认</view>
    </view>
  </view>

  <view class="card table-fee-card" wx:if="{{game.tableFee.enabled}}">
    <view class="fee-card-head">
      <view>
        <view class="title fee-card-title">台费</view>
        <view class="fee-card-subtitle">独立统计，不计入玩家分数</view>
      </view>
      <view class="fee-amount">{{game.tableFee.score}}</view>
    </view>
    <view class="score-section fee-score-section">
      <view class="section-label plus-label">台费加分</view>
      <view class="ops fee-ops">
        <block wx:for="{{tableFeePlusDeltas}}" wx:key="*this">
          <view class="score-btn plus" data-delta="{{item}}" bindtap="applyTableFeeDelta">+{{item}}</view>
        </block>
      </view>
    </view>
    <view class="score-section fee-score-section">
      <view class="section-label minus-label">台费减分</view>
      <view class="ops fee-ops">
        <block wx:for="{{tableFeeMinusDeltas}}" wx:key="*this">
          <view class="score-btn minus" data-delta="{{item}}" bindtap="applyTableFeeDelta">{{item}}</view>
        </block>
      </view>
    </view>
    <view class="fee-record-list" wx:if="{{game.tableFee.records.length}}">
      <block wx:for="{{game.tableFee.records}}" wx:key="at" wx:for-item="feeRecord">
        <view class="fee-record-row">
          <text>第{{feeRecord.round}}回合</text>
          <text>{{feeRecord.delta > 0 ? '+' : ''}}{{feeRecord.delta}}</text>
        </view>
      </block>
    </view>
  </view>

  <view class="action-row action-row-3">
    <view class="secondary-btn action-btn" bindtap="nextRound">下一回合</view>
    <view class="warn-btn action-btn" bindtap="resetGame">重置</view>
    <view class="danger-btn action-btn" bindtap="endGame">结束计分</view>
  </view>

  <view class="card log-card" wx:if="{{roundList.length}}">
    <view class="title2">历史回合得分</view>
    <block wx:for="{{roundList}}" wx:key="round" wx:for-item="roundItem">
      <view class="round-item">
        <view class="round-tag">第{{roundItem.round}}回合</view>
        <block wx:for="{{roundItem.scores}}" wx:key="at" wx:for-item="scoreItem">
          <view class="log-line"><text>{{scoreItem.playerName}}</text><text>{{scoreItem.delta>0?'+':''}}{{scoreItem.delta}}</text></view>
        </block>
      </view>
    </block>
  </view>
</view>
