.header-card,
.action-card,
.log-card {
  background: #ffffff;
}

.round {
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.players-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.player-chip {
  background: #fffaf6;
  border: 2rpx solid transparent;
  border-radius: 20rpx;
  padding: 18rpx 14rpx;
  text-align: center;
  box-sizing: border-box;
}

.player-chip.active {
  background: #e49b73;
  border-color: #e49b73;
  color: #ffffff;
  box-shadow: 0 14rpx 28rpx rgba(228, 155, 115, 0.20);
}

.avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: #ffffff;
  margin: 0 auto 10rpx;
  border: 1rpx solid #f0d9cb;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.player-chip.active .avatar {
  background: rgba(255, 255, 255, 0.14);
  border-color: rgba(255, 255, 255, 0.42);
}

.name {
  display: block;
  color: #374151;
  font-size: 28rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.score {
  display: block;
  color: #1f2937;
  font-size: 36rpx;
  font-weight: 800;
  margin-top: 4rpx;
}

.player-chip.active .name,
.player-chip.active .score {
  color: #ffffff;
}

.title {
  font-size: 32rpx;
  margin-bottom: 18rpx;
  color: #1f2937;
  font-weight: 700;
}

.score-section {
  margin-bottom: 20rpx;
}

.section-label {
  font-size: 26rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.plus-label {
  color: #c66d61;
}

.minus-label {
  color: #5f8f6a;
}

.ops {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.score-btn {
  width: 100%;
  min-width: 0;
  height: 82rpx;
  border-radius: 16rpx;
  font-weight: 800;
  font-size: 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 1rpx rgba(228, 155, 115, 0.08);
}

.minus {
  background: #edf7ef;
  color: #5f8f6a;
}

.plus {
  background: #fff0ee;
  color: #c66d61;
}

.custom-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.sign-switch {
  width: 128rpx;
  height: 84rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f6f7f9;
  border: 1rpx solid #eef0f3;
  box-sizing: border-box;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 6rpx;
  flex-shrink: 0;
}

.sign-btn {
  min-width: 0;
  border-radius: 14rpx;
  color: #8a94a6;
  font-size: 34rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sign-btn.active {
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(31, 41, 55, 0.10);
}

.plus-active {
  background: #c66d61;
}

.minus-active {
  background: #5f8f6a;
}

.custom-input {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  background: #fffaf6;
  border: 1rpx solid #eef0f3;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.confirm-btn {
  width: 168rpx;
  height: 84rpx;
  font-size: 30rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.action-btn {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  font-size: 28rpx;
  border-radius: 18rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.action-row .secondary-btn {
  background: #ffffff;
  color: #374151;
  border: 1rpx solid #d9dee7;
  box-shadow: none;
}

.warn-btn {
  background: #fef3c7;
  color: #92400e;
}

.danger-btn {
  background: #e49b73;
  color: #ffffff;
}

.title2 {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 14rpx;
}

.round-item {
  background: #fffaf6;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.round-tag {
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.log-line {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  color: #374151;
}
