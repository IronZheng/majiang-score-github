<view class="container join-page">
  <view wx:if="{{error}}" class="error-card">
    <view class="error-text">{{error}}</view>
    <view class="primary-btn" bindtap="goHome">返回首页</view>
  </view>

  <block wx:else>
    <view class="card room-card">
      <view class="room-label">你要加入的房间</view>
      <view class="room-id">{{roomId}}</view>
    </view>

    <view class="card join-profile">
      <image wx:if="{{avatarUrl}}" class="join-avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="join-avatar placeholder">{{initial}}</view>
      <view class="join-name">{{nickname || '牌友'}}</view>
      <view class="join-sub">以此身份加入（可在「我的」中修改）</view>
    </view>

    <view class="primary-btn join-btn" bindtap="join">{{joining ? '加入中…' : '加入房间'}}</view>
    <view class="tip">加入后你将看到实时排名，任何人都可修改分数</view>
  </block>
</view>
