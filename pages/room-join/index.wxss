.join-page {
  font-size: 30rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
  color: #1f2937;
}

.room-card {
  text-align: center;
}

.room-label {
  font-size: 26rpx;
  color: #9ca3af;
  margin-bottom: 12rpx;
}

.room-id {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 8rpx;
  color: #e49b73;
}

.nick-input {
  height: 84rpx;
  background: #fffaf6;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.join-btn {
  width: 100%;
  height: 96rpx;
  margin: 6rpx 0 18rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tip {
  text-align: center;
  color: #9ca3af;
  font-size: 25rpx;
  line-height: 1.5;
}

.error-card {
  text-align: center;
  padding: 80rpx 20rpx;
}

.error-text {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 40rpx;
  line-height: 1.6;
}

.error-card .primary-btn {
  width: 60%;
  height: 88rpx;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

/* ===== 授权面板 ===== */
.auth-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 16rpx 40rpx rgba(184, 97, 66, 0.14);
  margin-bottom: 28rpx;
}

.avatar-btn {
  width: 150rpx;
  height: 150rpx;
  margin: 0 auto 26rpx;
  padding: 0;
  border-radius: 50%;
  background: #fff4ed;
  border: 2rpx dashed #e49b73;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  color: #c08a6a;
  font-size: 24rpx;
}
