<view class="container create-page">
  <view class="card">
    <view class="title">房间名称</view>
    <input class="title-input" placeholder="给房间起个名字（可选）" value="{{title}}" bindinput="onTitleInput" maxlength="20" />
  </view>

  <view class="card">
    <view class="title">人数上限</view>
    <view class="cap-grid">
      <view wx:for="{{capacityOptions}}" wx:key="*this"
            class="cap-btn {{capacity===item?'active':''}}" data-cap="{{item}}" bindtap="setCapacity">{{item}}人</view>
    </view>
  </view>

  <view class="card fee-card {{tableFeeEnabled ? '' : 'fee-disabled'}}">
    <view class="fee-top">
      <view>
        <view class="title fee-title">台费</view>
        <view class="fee-subtitle">勾选后计分显示独立台费栏目</view>
      </view>
      <checkbox-group class="fee-check-group" bindchange="onFeeChange">
        <label class="fee-check">
          <checkbox value="enabled" checked="{{tableFeeEnabled}}" color="#e49b73" />
        </label>
      </checkbox-group>
    </view>
    <input wx:if="{{tableFeeEnabled}}" class="fee-input" type="number" placeholder="每底台费分值" value="{{tableFeeScore}}" bindinput="onFeeScoreInput" />
  </view>

  <view class="primary-btn create-btn" bindtap="create">{{creating ? '创建中…' : '创建房间'}}</view>
  <view class="tip">创建后把房间分享给牌友，或展示小程序码让他们扫码加入</view>
</view>

<view class="overlay" wx:if="{{inviteVisible}}">
  <view class="invite-card">
    <view class="invite-title">邀请好友加入</view>
    <view class="invite-room">房间号：{{roomId}} <text class="copy" bindtap="copyRoomId">复制</text></view>
    <button class="share-btn" open-type="share">分享给好友</button>
    <image wx:if="{{qrcode}}" class="qrcode-img" src="{{qrcode}}" mode="aspectFit"></image>
    <view wx:elif="{{qrcodeLoading}}" class="qrcode-tip">小程序码生成中…</view>
    <view wx:else class="qrcode-tip">小程序码暂不可用，可改用上方分享按钮</view>
    <view class="invite-actions">
      <view class="ghost-btn" bindtap="toggleInvite">稍后</view>
      <view class="primary-btn" bindtap="enterBoard">进入房间</view>
    </view>
  </view>
</view>
