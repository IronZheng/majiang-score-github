<view class="container multi-page">
  <!-- 授权面板：进入即要求头像 + 昵称 -->
  <view wx:if="{{needAuth}}" class="auth-mask">
    <view class="auth-card">
      <view class="auth-title">欢迎使用多人记账</view>
      <view class="auth-sub">请先设置头像和昵称</view>
      <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder">点击选头像</view>
      </button>
      <input class="nick-input" type="nickname" placeholder="请输入昵称" value="{{nickname}}" bindinput="onNicknameInput" />
      <view class="primary-btn auth-btn" bindtap="confirmAuth">进入</view>
    </view>
  </view>

  <view wx:else class="multi-body">
    <view class="add-my-guide" wx:if="{{showAddMyGuide}}">
      <view class="guide-arrow"></view>
      <view class="guide-icon">+</view>
      <view class="guide-copy">
        <view class="guide-title">喜欢这个小程序？把它留下吧</view>
        <view class="guide-desc">点右上角「···」，选择「添加到我的小程序」，下次开局不迷路</view>
      </view>
      <view class="guide-close" catchtap="dismissAddMyGuide" role="button" aria-label="关闭提示">×</view>
    </view>

    <view class="page-head">
      <view class="page-title">多人记账</view>
      <view class="page-sub">建房间 · 扫码一起计分</view>
    </view>

    <view class="menu-grid">
      <view class="menu-cell create" bindtap="openCreate">
        <view class="menu-ico">＋</view>
        <view class="menu-name">创建房间</view>
        <view class="menu-desc">开一桌，分享二维码</view>
      </view>
      <view class="menu-cell progress" bindtap="goInProgress">
        <view class="menu-ico">▶</view>
        <view class="menu-name">进行中</view>
        <view class="menu-desc">未结束的房间</view>
      </view>
      <view class="menu-cell history" bindtap="goHistory">
        <view class="menu-ico">☰</view>
        <view class="menu-name">历史记录</view>
        <view class="menu-desc">已结束的房间</view>
      </view>
    </view>
  </view>

  <!-- 创建房间弹窗 -->
  <view class="overlay" wx:if="{{showCreate}}">
    <view class="create-card">
      <view class="create-title">创建房间</view>
      <view class="card">
        <view class="title">房间名称</view>
        <input class="title-input" placeholder="给房间起个名字（可选）" value="{{createTitle}}" bindinput="onTitleInput" maxlength="20" />
      </view>
      <view class="card fee-card {{tableFeeEnabled ? '' : 'fee-disabled'}}">
        <view class="fee-top">
          <view>
            <view class="title fee-title">台费</view>
            <view class="fee-subtitle">勾选后计分显示独立台费栏目</view>
          </view>
          <checkbox-group class="fee-check-group" bindchange="onFeeChange">
            <label class="fee-check">
              <checkbox value="enabled" checked="{{tableFeeEnabled}}" color="#e49b73" />
            </label>
          </checkbox-group>
        </view>
        <input wx:if="{{tableFeeEnabled}}" class="fee-input" type="number" placeholder="每底台费分值" value="{{tableFeeScore}}" bindinput="onFeeScoreInput" />
      </view>
      <view class="create-actions">
        <view class="ghost-btn" bindtap="closeCreate">取消</view>
        <view class="primary-btn" bindtap="createRoom">{{creating ? '创建中…' : '创建并进入'}}</view>
      </view>
    </view>
  </view>
</view>
