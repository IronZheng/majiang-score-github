<view class="container multi-page">
  <!-- 顶部身份条：与「我的」页共享，只读展示 -->
  <view class="identity-bar">
    <view class="identity-left">
      <image wx:if="{{avatarUrl}}" class="identity-avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
      <view wx:else class="identity-avatar placeholder">{{avatarInitial}}</view>
      <view class="identity-text">
        <view class="identity-name">{{nickname || '未设置'}}</view>
        <view class="identity-tip">在「我的」页修改头像昵称</view>
      </view>
    </view>
    <view class="identity-tag">多人记账</view>
  </view>

  <!-- 添加小程序引导 -->
  <view class="add-my-guide" wx:if="{{showAddMyGuide}}">
    <view class="guide-icon">＋</view>
    <view class="guide-copy">
      <view class="guide-title">把它加入「我的小程序」</view>
      <view class="guide-desc">点右上角「···」即可添加，下次开局不迷路</view>
    </view>
    <view class="guide-close" catchtap="dismissAddMyGuide" role="button" aria-label="关闭提示">×</view>
  </view>

  <!-- 主操作：创建房间 -->
  <view class="hero-create" bindtap="openCreate">
    <view class="hero-ico">＋</view>
    <view class="hero-info">
      <view class="hero-title">创建房间</view>
      <view class="hero-sub">开一桌，生成二维码邀请好友扫码加入</view>
    </view>
  </view>

  <!-- 进行中房间：直接列表展示 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">进行中</view>
      <view class="section-count">{{progressList.length}}</view>
      <view wx:if="{{progressList.length > 0}}" class="section-more" bindtap="goInProgress">全部 ›</view>
    </view>

    <view wx:if="{{loading}}" class="section-loading">加载中…</view>

    <view wx:if="{{!loading && progressList.length === 0}}" class="section-empty">进行中 0</view>

    <view wx:for="{{progressList}}" wx:for-index="index" wx:key="roomId" class="room-cell" wx:if="{{index < 4}}" data-room-id="{{item.roomId}}" bindtap="openProgressRoom">
      <view class="room-main">
        <view class="room-name">{{item.title}}</view>
        <view class="room-meta">{{item.dateText}}{{item.dateText ? ' · ' : ''}}{{item.statusText}} · {{item.memberCount}}人{{item.isHost ? ' · 房主' : ''}}</view>
      </view>
      <view class="room-arrow">›</view>
    </view>
  </view>

  <!-- 历史记录入口 -->
  <view class="entry-cell" bindtap="goHistory">
    <view class="entry-ico history">☰</view>
    <view class="hero-info">
      <view class="entry-name">历史记录</view>
      <view class="entry-desc">查看已结束的房间</view>
    </view>
  </view>

  <!-- 创建房间弹窗 -->
  <view class="overlay" wx:if="{{showCreate}}">
      <view class="create-card">
      <view class="create-title">创建房间</view>
      <view class="card fee-card {{tableFeeEnabled ? '' : 'fee-disabled'}}">
        <view class="fee-top">
          <view>
            <view class="title fee-title">台费</view>
            <view class="fee-subtitle">开启后，每圈记账时实时填入台费</view>
          </view>
          <checkbox-group class="fee-check-group" bindchange="onFeeChange">
            <label class="fee-check">
              <checkbox value="enabled" checked="{{tableFeeEnabled}}" color="#e49b73" />
            </label>
          </checkbox-group>
        </view>
      </view>
      <view class="create-actions">
        <view class="ghost-btn" bindtap="closeCreate">取消</view>
        <view class="primary-btn" bindtap="createRoom">{{creating ? '创建中…' : '创建并进入'}}</view>
      </view>
    </view>
  </view>
</view>
