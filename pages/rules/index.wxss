.multi-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  font-size: 30rpx;
}

/* ===== 顶部身份条 ===== */
.identity-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.14);
  border-radius: 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(120, 88, 64, 0.08);
  box-sizing: border-box;
}

.identity-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
}

.identity-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff4ed;
  border: 2rpx solid #f0d9cb;
  overflow: hidden;
}

.identity-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c08a6a;
  font-size: 38rpx;
  font-weight: 700;
}

.identity-text {
  min-width: 0;
}

.identity-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.4;
}

.identity-tip {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.identity-tag {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(224, 123, 69, 0.22);
}

/* ===== 添加小程序引导 ===== */
.add-my-guide {
  position: relative;
  margin: 0 0 22rpx;
  padding: 22rpx 64rpx 22rpx 22rpx;
  border: 1rpx solid rgba(228, 155, 115, 0.18);
  border-radius: 20rpx;
  background: #fff4ed;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.guide-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #e49b73;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guide-copy {
  flex: 1;
  min-width: 0;
}

.guide-title {
  color: #8f4f31;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.guide-desc {
  margin-top: 4rpx;
  color: #9a6a54;
  font-size: 23rpx;
  line-height: 1.5;
}

.guide-close {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  color: #b98b74;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-close:active {
  background: rgba(228, 155, 115, 0.12);
}

/* ===== 统一板块骨架（创建 / 进行中 / 历史 共用） ===== */
/* 三块统一：外间距、头部高度、字体阶梯、圆角、阴影，仅用色相区分层级与状态 */
.section {
  margin-bottom: 22rpx;
}

/* 板块头部：标题竖条 + 标题 + 计数/更多（统一结构） */
.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 4rpx 6rpx 16rpx;
}

.section-title {
  position: relative;
  padding-left: 22rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.3;
}

/* 标题左侧竖条：主题色，三块共用同一形态仅靠颜色区分 */
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: currentColor;
  opacity: 0.9;
}

/* 状态计数徽标（进行中） */
.section-count {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

/* “更多/去创建”链接 */
.section-more {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 4rpx;
}

/* 统一内容面板：卡片内间距、圆角、阴影一致 */
.panel {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 30rpx 26rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

.panel:active {
  transform: scale(0.99);
  opacity: 0.94;
}

/* 面板图标徽标（方角圆角，白字） */
.panel-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 300;
  line-height: 1;
  color: #ffffff;
  flex-shrink: 0;
}

.panel-info,
.panel-main {
  flex: 1;
  min-width: 0;
}

.panel-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.4;
}

.panel-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.45;
}

.panel-arrow {
  font-size: 44rpx;
  color: #c9b8ac;
  line-height: 1;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 空 / 加载态：与面板同圆角，主题浅底 */
.section-loading,
.section-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 27rpx;
  border-radius: 22rpx;
  box-sizing: border-box;
  margin-bottom: 16rpx;
}

/* ---- 板块一：创建房间（主操作，层级最高，实色橙） ---- */
.section--create .section-title::before {
  color: #e07b45;
}
.section--create .section-more {
  color: #e07b45;
}
.panel--solid {
  background: linear-gradient(135deg, #f0a070, #e07b45);
  box-shadow: 0 18rpx 40rpx rgba(224, 123, 69, 0.28);
  border: 1rpx solid rgba(224, 123, 69, 0.3);
}
.panel--solid .panel-ico {
  background: rgba(255, 255, 255, 0.22);
}
.panel--solid .panel-title {
  color: #ffffff;
}
.panel--solid .panel-desc {
  color: rgba(255, 255, 255, 0.86);
}
.panel--solid .panel-arrow {
  color: rgba(255, 255, 255, 0.8);
}

/* ---- 板块二：进行中（活跃状态，青绿） ---- */
.section--progress .section-title::before {
  color: #1f9e8c;
}
.section--progress .section-count {
  background: linear-gradient(135deg, #36c0a8, #1f9e8c);
}
.section--progress .section-more {
  color: #1f9e8c;
}
.section--progress .panel--item {
  background: #ffffff;
  border: 1rpx solid rgba(31, 158, 140, 0.16);
  border-left: 6rpx solid #1f9e8c;
  box-shadow: 0 12rpx 30rpx rgba(31, 130, 110, 0.07);
}
.section--progress .section-loading,
.section--progress .section-empty {
  color: #6aa99c;
  background: #eafaf5;
  border: 1rpx solid rgba(31, 158, 140, 0.16);
}

/* ---- 板块三：历史记录（归档，靛蓝） ---- */
.section--history .section-title::before {
  color: #486bc4;
}
.section--history .panel--item {
  background: #ffffff;
  border: 1rpx solid rgba(72, 107, 196, 0.18);
  border-left: 6rpx solid #486bc4;
  box-shadow: 0 12rpx 30rpx rgba(60, 90, 170, 0.08);
}
.section--history .panel-ico {
  background: linear-gradient(135deg, #6f8ee0, #486bc4);
  box-shadow: 0 10rpx 22rpx rgba(72, 107, 196, 0.28);
}

/* ===== 创建弹窗 ===== */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  z-index: 80;
}

.create-card {
  width: 100%;
  background: #ffffff;
  border-radius: 26rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
}

/* 弹窗头部：橙主题图标 + 标题，形成明确视觉锚点 */
.create-head {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 28rpx;
}

.create-head-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  box-shadow: 0 14rpx 30rpx rgba(224, 123, 69, 0.28);
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.create-head-text {
  min-width: 0;
}

.create-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.3;
}

.create-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
  line-height: 1.45;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.13);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 88, 64, 0.07);
  padding: 24rpx 22rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
  color: #1f2937;
}

.title-input {
  width: 100%;
  height: 84rpx;
  background: #fffaf6;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.fee-card {
  background: #ffffff;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

/* 台费开启态：橙描边强调，明确“已启用” */
.fee-card.on {
  border-color: rgba(224, 123, 69, 0.35);
  box-shadow: 0 12rpx 30rpx rgba(224, 123, 69, 0.12);
}

.fee-card.fee-disabled {
  background: #f8f9fb;
}

.fee-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.fee-ico {
  width: 60rpx;
  height: 60rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #f6d9c4, #f0c3a6);
  color: #c0673a;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.fee-card.on .fee-ico {
  background: linear-gradient(135deg, #f0a070, #e07b45);
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(224, 123, 69, 0.28);
}

.fee-copy {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

.fee-title {
  margin-bottom: 8rpx;
}

.fee-subtitle {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.45;
}

.fee-check-group {
  flex-shrink: 0;
}

.fee-check {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.create-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 10rpx;
}

.ghost-btn {
  flex: 0 0 200rpx;
  height: 92rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ghost-btn:active {
  opacity: 0.7;
}

.primary-btn {
  flex: 1;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  border-radius: 16rpx;
  box-shadow: 0 14rpx 30rpx rgba(224, 123, 69, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-btn:active {
  transform: scale(0.99);
  opacity: 0.92;
}
