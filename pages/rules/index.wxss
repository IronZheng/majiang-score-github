.multi-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  font-size: 30rpx;
}

/* ===== 顶部身份条 ===== */
.identity-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 26rpx;
  margin-bottom: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.14);
  border-radius: 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(120, 88, 64, 0.08);
  box-sizing: border-box;
}

.identity-left {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-width: 0;
}

.identity-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff4ed;
  border: 2rpx solid #f0d9cb;
  overflow: hidden;
}

.identity-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c08a6a;
  font-size: 38rpx;
  font-weight: 700;
}

.identity-text {
  min-width: 0;
}

.identity-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.4;
}

.identity-tip {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9ca3af;
}

.identity-tag {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(224, 123, 69, 0.22);
}

/* ===== 添加小程序引导 ===== */
.add-my-guide {
  position: relative;
  margin: 0 0 22rpx;
  padding: 22rpx 64rpx 22rpx 22rpx;
  border: 1rpx solid rgba(228, 155, 115, 0.18);
  border-radius: 20rpx;
  background: #fff4ed;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.guide-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #e49b73;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.guide-copy {
  flex: 1;
  min-width: 0;
}

.guide-title {
  color: #8f4f31;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.35;
}

.guide-desc {
  margin-top: 4rpx;
  color: #9a6a54;
  font-size: 23rpx;
  line-height: 1.5;
}

.guide-close {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  color: #b98b74;
  font-size: 36rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-close:active {
  background: rgba(228, 155, 115, 0.12);
}

/* ===== 主操作：创建房间 ===== */
.hero-create {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 22rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  box-shadow: 0 18rpx 40rpx rgba(224, 123, 69, 0.28);
  box-sizing: border-box;
}

.hero-create:active {
  transform: scale(0.99);
  opacity: 0.94;
}

.hero-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.hero-info {
  flex: 1;
  min-width: 0;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.hero-sub {
  margin-top: 6rpx;
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.45;
}

/* ===== 进行中列表区 ===== */
.section {
  margin-bottom: 22rpx;
}

.section-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 4rpx 6rpx 16rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
}

.section-count {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 800;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.section-more {
  margin-left: auto;
  font-size: 26rpx;
  color: #e07b45;
  font-weight: 700;
  padding: 6rpx 4rpx;
}

.section-loading,
.section-empty {
  padding: 40rpx 0;
  text-align: center;
  font-size: 27rpx;
  color: #9ca3af;
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.1);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 88, 64, 0.06);
}

.room-cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.12);
  border-radius: 18rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 88, 64, 0.06);
  box-sizing: border-box;
}

.room-cell:active {
  transform: scale(0.99);
  opacity: 0.92;
}

.room-main {
  flex: 1;
  min-width: 0;
}

.room-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.room-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.room-arrow {
  font-size: 44rpx;
  color: #c9b8ac;
  line-height: 1;
  margin-left: 16rpx;
}

/* ===== 历史记录入口 ===== */
.entry-cell {
  display: flex;
  align-items: center;
  gap: 26rpx;
  padding: 30rpx 26rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(120, 88, 64, 0.08);
  border: 1rpx solid rgba(228, 155, 115, 0.12);
  box-sizing: border-box;
}

.entry-cell:active {
  transform: scale(0.99);
  opacity: 0.92;
}

.entry-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  font-weight: 800;
  color: #ffffff;
  flex-shrink: 0;
}

.entry-ico.history {
  background: linear-gradient(135deg, #b6a0f0, #7b5fd9);
}

.entry-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.entry-desc {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #9ca3af;
  line-height: 1.4;
}

/* ===== 创建弹窗 ===== */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  z-index: 80;
}

.create-card {
  width: 100%;
  background: #ffffff;
  border-radius: 26rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.create-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.13);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 88, 64, 0.07);
  padding: 24rpx 22rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
  color: #1f2937;
}

.title-input {
  width: 100%;
  height: 84rpx;
  background: #fffaf6;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.fee-card {
  background: #ffffff;
  transition: opacity 0.2s ease;
}

.fee-card.fee-disabled {
  background: #f8f9fb;
}

.fee-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.fee-title {
  margin-bottom: 8rpx;
}

.fee-subtitle {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.45;
}

.fee-check-group {
  flex-shrink: 0;
}

.fee-check {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.create-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 6rpx;
}

.ghost-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ghost-btn:active {
  opacity: 0.7;
}

.primary-btn {
  flex: 1;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  border-radius: 16rpx;
  box-shadow: 0 14rpx 30rpx rgba(224, 123, 69, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-btn:active {
  transform: scale(0.99);
  opacity: 0.92;
}
