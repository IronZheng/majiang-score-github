.multi-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
  font-size: 30rpx;
}

/* ===== 顶部个人资料卡 ===== */
.profile-bar {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 26rpx;
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.14);
  border-radius: 22rpx;
  box-shadow: 0 14rpx 34rpx rgba(120, 88, 64, 0.08);
  box-sizing: border-box;
}

.profile-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff4ed;
  border: 2rpx solid #f0d9cb;
  overflow: hidden;
}

.profile-avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c08a6a;
  font-size: 40rpx;
  font-weight: 700;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.4;
}

.profile-tip {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* ===== 授权/编辑面板 ===== */
.auth-card {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 56rpx 44rpx 44rpx;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 20rpx 50rpx rgba(184, 97, 66, 0.18);
}

.auth-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2937;
}

.auth-sub {
  margin-top: 10rpx;
  margin-bottom: 40rpx;
  color: #9ca3af;
  font-size: 26rpx;
}

.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 30rpx;
  padding: 0;
  border-radius: 50%;
  background: #fff4ed;
  border: 2rpx dashed #e49b73;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-btn::after {
  border: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  color: #c08a6a;
  font-size: 24rpx;
}

.nick-input {
  width: 100%;
  height: 88rpx;
  background: #fffaf6;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  text-align: center;
  box-sizing: border-box;
  margin-bottom: 36rpx;
}

.auth-btn {
  width: 100%;
  height: 92rpx;
  font-size: 32rpx;
}

/* ===== 主体 ===== */
.add-my-guide {
  position: relative;
  min-height: 116rpx;
  margin: 0 0 24rpx;
  padding: 22rpx 72rpx 22rpx 22rpx;
  border: 1rpx solid rgba(228, 155, 115, 0.18);
  border-radius: 22rpx;
  background: #fff4ed;
  box-shadow: 0 12rpx 30rpx rgba(228, 155, 115, 0.12);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.guide-arrow {
  position: absolute;
  top: -14rpx;
  right: 78rpx;
  width: 26rpx;
  height: 26rpx;
  background: #fff4ed;
  border-top: 1rpx solid rgba(228, 155, 115, 0.18);
  border-left: 1rpx solid rgba(228, 155, 115, 0.18);
  transform: rotate(45deg);
}

.guide-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #e49b73;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(228, 155, 115, 0.22);
}

.guide-copy {
  flex: 1;
  min-width: 0;
}

.guide-title {
  color: #8f4f31;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.guide-desc {
  margin-top: 6rpx;
  color: #9a6a54;
  font-size: 24rpx;
  line-height: 1.5;
}

.guide-close {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  color: #b98b74;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-close:active {
  background: rgba(228, 155, 115, 0.12);
}

.page-head {
  margin: 8rpx 4rpx 28rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1f2937;
}

.page-sub {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.menu-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.menu-cell {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(120, 88, 64, 0.08);
  border: 1rpx solid rgba(228, 155, 115, 0.12);
}

.menu-cell:active {
  transform: scale(0.99);
  opacity: 0.92;
}

.menu-ico {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #ffffff;
  flex-shrink: 0;
}

.menu-cell.create .menu-ico {
  background: linear-gradient(135deg, #f0a070, #e07b45);
}

.menu-cell.progress .menu-ico {
  background: linear-gradient(135deg, #6fb1f0, #2f7ac9);
}

.menu-cell.history .menu-ico {
  background: linear-gradient(135deg, #b6a0f0, #7b5fd9);
}

.menu-name {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
}

.menu-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

/* ===== 创建弹窗 ===== */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  z-index: 80;
}

.create-card {
  width: 100%;
  background: #ffffff;
  border-radius: 26rpx;
  padding: 36rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.create-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 24rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.13);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 88, 64, 0.07);
  padding: 24rpx 22rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
  color: #1f2937;
}

.title-input,
.fee-input {
  width: 100%;
  height: 84rpx;
  background: #fffaf6;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.fee-card {
  background: #ffffff;
  transition: opacity 0.2s ease;
}

.fee-card.fee-disabled {
  background: #f8f9fb;
}

.fee-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.fee-title {
  margin-bottom: 8rpx;
}

.fee-subtitle {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.45;
}

.fee-check-group {
  flex-shrink: 0;
}

.fee-check {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.create-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 6rpx;
}

.ghost-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ghost-btn:active {
  opacity: 0.7;
}

.primary-btn {
  flex: 1;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  border-radius: 16rpx;
  box-shadow: 0 14rpx 30rpx rgba(224, 123, 69, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-btn:active {
  transform: scale(0.99);
  opacity: 0.92;
}
