.setup-page {
  padding-bottom: 156rpx;
  font-size: 30rpx;
}

.add-my-guide {
  position: relative;
  min-height: 116rpx;
  margin: 0 0 24rpx;
  padding: 22rpx 72rpx 22rpx 22rpx;
  border: 1rpx solid rgba(228, 155, 115, 0.18);
  border-radius: 22rpx;
  background: #fff4ed;
  box-shadow: 0 12rpx 30rpx rgba(228, 155, 115, 0.12);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.guide-arrow {
  position: absolute;
  top: -14rpx;
  right: 78rpx;
  width: 26rpx;
  height: 26rpx;
  background: #fff4ed;
  border-top: 1rpx solid rgba(228, 155, 115, 0.18);
  border-left: 1rpx solid rgba(228, 155, 115, 0.18);
  transform: rotate(45deg);
}

.guide-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #e49b73;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(228, 155, 115, 0.22);
}

.guide-copy {
  flex: 1;
  min-width: 0;
}

.guide-title {
  color: #8f4f31;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.guide-desc {
  margin-top: 6rpx;
  color: #9a6a54;
  font-size: 24rpx;
  line-height: 1.5;
}

.guide-close {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  color: #b98b74;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-close:active {
  background: rgba(228, 155, 115, 0.12);
}

.page-head {
  margin: 4rpx 4rpx 24rpx;
}

.page-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #1f2937;
  line-height: 1.2;
}

.page-sub {
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
  line-height: 1.5;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.13);
  border-radius: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(120, 88, 64, 0.07);
  padding: 24rpx 22rpx;
  margin-bottom: 22rpx;
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
  color: #1f2937;
}

.title-input,
.fee-input {
  width: 100%;
  height: 84rpx;
  background: #fffaf6;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 30rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.cap-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
}

.cap-btn {
  height: 84rpx;
  background: #f3f4f6;
  color: #4b5563;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cap-btn.active {
  background: #e49b73;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(228, 155, 115, 0.22);
}

.fee-card {
  background: #ffffff;
  transition: opacity 0.2s ease;
}

.fee-card.fee-disabled {
  background: #f8f9fb;
}

.fee-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.fee-title {
  margin-bottom: 8rpx;
}

.fee-subtitle {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.45;
}

.fee-check-group {
  flex-shrink: 0;
}

.fee-check {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn {
  width: 100%;
  height: 96rpx;
  margin: 6rpx 0 14rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  border-radius: 18rpx;
  box-shadow: 0 14rpx 30rpx rgba(224, 123, 69, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.primary-btn:active {
  transform: scale(0.99);
  opacity: 0.92;
}

.create-btn {
  margin-top: 4rpx;
}

.tip {
  text-align: center;
  color: #9ca3af;
  font-size: 23rpx;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  z-index: 50;
}

.invite-card {
  width: 100%;
  background: #ffffff;
  border-radius: 26rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.invite-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 22rpx;
}

.invite-room {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 22rpx;
}

.copy {
  color: #e07b45;
  font-weight: 700;
  margin-left: 8rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  border-radius: 16rpx;
  margin-bottom: 24rpx;
}

.share-btn::after {
  border: none;
}

.qrcode-img {
  width: 360rpx;
  height: 360rpx;
  margin: 0 auto 18rpx;
  display: block;
  background: #fffaf6;
  border-radius: 18rpx;
}

.qrcode-tip {
  color: #9ca3af;
  font-size: 24rpx;
  margin: 8rpx 0 18rpx;
}

.invite-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 14rpx;
}

.ghost-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.ghost-btn:active {
  opacity: 0.7;
}
