.profile-header{
  min-height:220rpx;
  background:linear-gradient(135deg,#e8f4ff 0%,#dceeff 50%,#f0f6ff 100%);
  display:flex;align-items:center;justify-content:center;
  padding:40rpx 32rpx;
  border-radius:0 0 40rpx 40rpx;
  flex-direction:column;
  gap:20rpx;
}

/* ===== 未登录引导 ===== */
.avatar-placeholder{
  width:120rpx;height:120rpx;border-radius:16rpx;
  background:#c9e3fb;color:#6d9fce;
  display:flex;align-items:center;justify-content:center;
  font-size:52rpx;font-weight:700;
}
.hint-text{font-size:26rpx;color:#8faabe;text-align:center}
.go-login-btn{
  background:linear-gradient(135deg,#70b7ff,#2f7ac9);
  color:#fff;border-radius:48rpx;
  font-size:30rpx;font-weight:600;
  padding:18rpx 72rpx;
  box-shadow:0 8rpx 24rpx rgba(47,122,201,0.3);
  margin-top:8rpx;
  border:none;
  line-height:1.5;
}
.go-login-btn::after{border:none}
.go-login-btn:active{transform:scale(0.96);opacity:0.85}

/* ===== 已登录：左右布局 ===== */
.logined{
  justify-content:flex-start;
  flex-direction:row;
  padding:32rpx;
}
.user-info-row{
  display:flex;
  flex-direction:row;
  align-items:center;
  gap:32rpx;
  width:100%;
}

/* 左侧头像 */
.avatar-lg{
  width:140rpx;height:140rpx;
  border-radius:16rpx;overflow:hidden;
  background:#e8f4ff;
  flex-shrink:0;
}
.avatar-lg image{width:100%;height:100%}
.avatar-btn{
  width:100%;height:100%;
  padding:0;margin:0;border:none;
  background:transparent;
  display:block;
  border-radius:16rpx;
  overflow:hidden;
}
.avatar-btn::after{border:none}

/* 右侧信息列 */
.info-col{
  display:flex;
  flex-direction:column;
  gap:8rpx;
  flex:1;
  min-width:0;
}

.nickname-row{
  display:flex;
  align-items:center;
  gap:8rpx;
}
.nickname-input{
  font-size:40rpx;
  font-weight:700;
  color:#2f5d88;
  padding:0;
  max-width:360rpx;
  min-height:48rpx;
  line-height:1.2;
  background:transparent;
}
.nickname-placeholder{
  font-size:36rpx;
  color:#b8ccdf;
}
.edit-hint{font-size:28rpx;color:#9ab0c7}

.phone{
  font-size:26rpx;
  color:#6d87a1;
  line-height:1.4;
}

.logout-row{margin-top:4rpx}
.logout-btn{
  font-size:24rpx;
  color:#c05050;
  padding:4rpx 18rpx;
  border:1rpx solid #e8c0c0;
  border-radius:999rpx;
}

/* ===== 历史记录 ===== */
.history-card{
  background:#fff;
  margin-top:-20rpx;
  border-radius:32rpx;
  box-shadow:0 -4rpx 24rpx rgba(47,122,201,0.06);
  padding:32rpx;
}
.title{font-size:32rpx;font-weight:600;margin-bottom:24rpx;color:#2f5d88}
.item{padding:24rpx;border-bottom:1rpx solid #f0f6ff}
.item:last-child{border-bottom:none}
.line1,.line2{display:flex;justify-content:space-between;align-items:center}
.line2{margin-top:12rpx}
.badge{background:#e8f4ff;color:#2f6fae;padding:6rpx 16rpx;border-radius:999rpx;font-size:24rpx}
.time{color:#9ab0c7;font-size:24rpx}
.champion{color:#5a4a3a;font-weight:600}
.score{color:#2f7ac9;font-weight:700}
.empty{color:#9ab0c7;text-align:center;padding:48rpx}
