.profile-header {
  min-height: 244rpx;
  background: #e49b73;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 18rpx 42rpx rgba(228, 155, 115, 0.20);
}

.profile-header > view,
.profile-header > text,
.profile-header > button {
  position: relative;
  z-index: 1;
}

.profile-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(228, 155, 115, 0) 0%, #fffaf6 100%);
  z-index: 0;
  pointer-events: none;
}

.avatar-placeholder {
  width: 128rpx;
  height: 128rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 800;
}

.hint-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.62);
  text-align: center;
}

.go-login-btn {
  background: #ffffff;
  color: #1f2937;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 800;
  padding: 0 72rpx;
  height: 82rpx;
  line-height: 82rpx;
  margin-top: 8rpx;
  border: none;
}

.go-login-btn::after,
.avatar-picker::after {
  border: none;
}

.go-login-btn:active {
  transform: scale(0.98);
  opacity: 0.86;
}

.logined {
  justify-content: flex-start;
  flex-direction: row;
  padding: 34rpx 32rpx;
}

.user-info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  width: 100%;
}

.avatar-lg {
  width: 136rpx;
  height: 136rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.22);
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(130, 72, 45, 0.14);
  box-sizing: border-box;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-fallback {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}

.avatar-picker {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  border: none;
  border-radius: 30rpx;
  background: transparent;
  opacity: 0;
  z-index: 2;
}

.info-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nickname-input {
  font-size: 42rpx;
  font-weight: 800;
  color: #ffffff;
  padding: 0;
  max-width: 360rpx;
  min-height: 52rpx;
  line-height: 1.2;
  background: transparent;
}

.nickname-placeholder {
  font-size: 38rpx;
  color: rgba(255, 255, 255, 0.44);
}

.edit-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.phone {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.58);
  line-height: 1.4;
}

.logout-row {
  margin-top: 8rpx;
}

.logout-btn {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  padding: 6rpx 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
}

.history-card {
  background: #ffffff;
  margin-top: 18rpx;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 36rpx rgba(228, 155, 115, 0.08);
  padding: 30rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
  color: #1f2937;
}

.item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eef0f3;
}

.item:last-child {
  border-bottom: none;
}

.line1,
.line2 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.line2 {
  margin-top: 12rpx;
}

.badge {
  background: #f3f4f6;
  color: #374151;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
}

.time {
  color: #9ca3af;
  font-size: 26rpx;
}

.champion {
  color: #1f2937;
  font-weight: 700;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score {
  color: #1f2937;
  font-weight: 800;
  flex-shrink: 0;
}

.empty {
  display: block;
  color: #9ca3af;
  text-align: center;
  padding: 56rpx 0;
}

.menu-card {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(136rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 8rpx 30rpx;
  margin-bottom: 0;
}

.menu-item {
  width: 100%;
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f1eee9;
  box-sizing: border-box;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 700;
}

.menu-arrow {
  color: #c9b8ac;
  font-size: 32rpx;
  font-weight: 700;
}

.container {
  padding-bottom: 400rpx;
}
