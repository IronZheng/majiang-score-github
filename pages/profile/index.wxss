.profile-header {
  min-height: 244rpx;
  background: #e49b73;
  color: #ffffff;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 42rpx 32rpx;
  border-radius: 0 0 32rpx 32rpx;
  flex-direction: column;
  gap: 20rpx;
  box-shadow: 0 18rpx 42rpx rgba(228, 155, 115, 0.20);
}

.user-info-row {
  position: relative;
  z-index: 1;
}

.profile-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, rgba(228, 155, 115, 0) 0%, #fffaf6 100%);
  z-index: 0;
  pointer-events: none;
}

.logined {
  justify-content: flex-start;
  flex-direction: row;
  padding: 34rpx 32rpx;
}

.user-info-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 28rpx;
  width: 100%;
}

.avatar-lg {
  width: 136rpx;
  height: 136rpx;
  border-radius: 30rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.22);
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 24rpx rgba(130, 72, 45, 0.14);
  box-sizing: border-box;
}

.avatar-btn {
  min-width: 136rpx;
  max-width: 136rpx;
  padding: 0;
  margin: 0;
  line-height: 1;
  border: 0;
  color: inherit;
  display: flex;
}

.avatar-btn::after {
  border: 0;
}

.avatar-lg:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-fallback {
  color: #ffffff;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1;
}

.info-col {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.nickname-input {
  font-size: 42rpx;
  font-weight: 800;
  color: #ffffff;
  padding: 0;
  max-width: 360rpx;
  min-height: 52rpx;
  line-height: 1.2;
  background: transparent;
}

.nickname-placeholder {
  font-size: 38rpx;
  color: rgba(255, 255, 255, 0.44);
}

.edit-hint {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
}

.profile-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}

.reset-profile {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  white-space: nowrap;
}

.reset-profile {
  color: rgba(255, 255, 255, 0.64);
  background: rgba(255, 255, 255, 0.08);
}

.history-card {
  background: #ffffff;
  margin-top: 22rpx;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 36rpx rgba(228, 155, 115, 0.08);
  padding: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.history-count {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff4ed;
  color: #c96f45;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.head-right {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-shrink: 0;
}

.sync-cloud-btn {
  margin: 0;
  padding: 0 20rpx;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 18rpx rgba(224, 123, 69, 0.25);
}

.sync-cloud-btn::after {
  border: none;
}

.cloud-hint {
  margin: -8rpx 0 18rpx;
  font-size: 22rpx;
  color: #9ca3af;
}

.item {
  padding: 22rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #f1eee9;
  border-radius: 20rpx;
  background: #fffdfb;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(31, 41, 55, 0.03);
}

.item:last-child {
  margin-bottom: 0;
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.record-sub {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20rpx;
}

.record-main {
  min-height: 44rpx;
}

.record-sub {
  margin-top: 14rpx;
}

.record-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.badge {
  background: #fff4ed;
  color: #9a5a38;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.time {
  color: #a9a09a;
  font-size: 24rpx;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.champion {
  color: #1f2937;
  font-weight: 700;
  font-size: 30rpx;
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.score {
  color: #c96f45;
  font-size: 30rpx;
  font-weight: 800;
}

.record-arrow {
  color: #d5c7bd;
  font-size: 28rpx;
  font-weight: 800;
}

.delete-record-btn {
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  background: rgba(198, 109, 97, 0.08);
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-record-icon {
  width: 22rpx;
  height: 22rpx;
  display: block;
}

.empty {
  display: block;
  color: #9ca3af;
  text-align: center;
  padding: 56rpx 0;
}

.menu-card {
  padding: 8rpx 26rpx;
  margin-top: 24rpx;
  margin-bottom: 0;
}

.menu-item {
  width: 100%;
  min-height: 96rpx;
  padding: 18rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #f1eee9;
  box-sizing: border-box;
}

.contact-menu-item {
  position: relative;
}

.contact-hit-button {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  background: transparent;
  border-radius: 0;
  opacity: 0;
}

.contact-hit-button::after {
  border: 0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  flex: 1;
}

.menu-symbol {
  width: 42rpx;
  height: 42rpx;
  border-radius: 14rpx;
  background: #fff4ed;
  color: #c96f45;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.menu-title {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.35;
}

.menu-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.menu-subtitle {
  color: #9da3ad;
  font-size: 23rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  color: #c9b8ac;
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.container {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}
