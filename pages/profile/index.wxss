.profile-card{display:flex;justify-content:center;flex-direction:column;gap:8rpx;background:linear-gradient(135deg,#ecf6ff,#dceeff)}
.title{font-size:30rpx;font-weight:600;margin-bottom:12rpx;color:#2f5d88}
.history-card{background:#fffaf3}
.item{padding:18rpx 14rpx;border:1rpx solid #f1e4d2;border-radius:12rpx;margin-bottom:12rpx;background:#fff}
.line1,.line2{display:flex;justify-content:space-between;align-items:center}
.line2{margin-top:8rpx}
.badge{background:#eaf3ff;color:#2f6fae;padding:4rpx 12rpx;border-radius:999rpx;font-size:22rpx}
.time{color:#7b8fa3;font-size:22rpx}
.champion{color:#8c5d2f;font-weight:600}
.score{color:#2f7ac9;font-weight:700}
.hello{font-size:32rpx;color:#2f5d88}
.sub{font-size:24rpx;color:#6d87a1}
.empty{color:#8fa1b4}
