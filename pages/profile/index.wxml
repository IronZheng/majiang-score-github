<view class="container">

  <view class="profile-header logined">
    <view class="user-info-row">
      <button class="avatar-lg avatar-btn" style="background:{{avatarBg}}" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image
          wx:if="{{userInfo.avatarUrl}}"
          class="avatar-image"
          src="{{userInfo.avatarUrl}}"
          mode="aspectFill"
        ></image>
        <text wx:else class="avatar-fallback">玩</text>
      </button>
      <view class="info-col">
        <view class="nickname-row">
          <input
            class="nickname-input"
            type="nickname"
            value="{{userInfo.nickName || '玩家'}}"
            placeholder="输入微信昵称"
            placeholder-class="nickname-placeholder"
            bindinput="onNicknameInput"
            bindconfirm="onNicknameConfirm"
            bindblur="onNicknameBlur"
          />
          <text class="edit-hint">✎</text>
        </view>
        <view class="profile-actions">
          <text class="reset-profile" bindtap="resetDefaultProfile">恢复默认</text>
        </view>
      </view>
    </view>
    <view class="profile-fade"></view>
  </view>

  <view class="card menu-card">
    <view class="menu-item" bindtap="showAbout">
      <view class="menu-left">
        <text class="menu-symbol">i</text>
        <view class="menu-copy">
          <text class="menu-title">小程序说明</text>
          <text class="menu-subtitle">了解计分、台费和历史记录</text>
        </view>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item contact-menu-item">
      <view class="menu-left">
        <text class="menu-symbol">聊</text>
        <view class="menu-copy">
          <text class="menu-title">联系客服</text>
          <text class="menu-subtitle">点击直接开始聊天，全天在线</text>
        </view>
      </view>
      <text class="menu-arrow">></text>
      <button
        class="contact-hit-button"
        open-type="contact"
        session-from="source=profile_contact"
        show-message-card="true"
        send-message-title="联系比特光年工作室"
        send-message-path="/pages/contact/index"
      ></button>
    </view>

    <view class="menu-item" bindtap="showAddMyGuide">
      <view class="menu-left">
        <text class="menu-symbol">+</text>
        <view class="menu-copy">
          <text class="menu-title">添加到我的小程序</text>
          <text class="menu-subtitle">下次访问不迷路</text>
        </view>
      </view>
      <text class="menu-arrow">></text>
    </view>

    <view class="menu-item" bindtap="openStudio">
      <view class="menu-left">
        <text class="menu-symbol">B</text>
        <view class="menu-copy">
          <text class="menu-title">比特光年工作室出品</text>
          <text class="menu-subtitle">出品方、技术服务、我们的产品</text>
        </view>
      </view>
      <text class="menu-arrow">></text>
    </view>
  </view>

</view>
