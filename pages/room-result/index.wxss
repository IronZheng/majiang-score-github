.result-page {
  font-size: 30rpx;
}

.error-text {
  text-align: center;
  color: #ef4444;
  padding: 60rpx 20rpx;
}

.result-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2937;
}

.result-room {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.best-banner {
  background: linear-gradient(135deg, #f6c177, #e49b73);
  border-radius: 24rpx;
  padding: 32rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(228, 155, 115, 0.25);
}

.best-label {
  font-size: 26rpx;
  opacity: 0.9;
}

.best-name {
  font-size: 48rpx;
  font-weight: 800;
  margin: 6rpx 0;
}

.best-score {
  font-size: 30rpx;
  font-weight: 700;
}

.result-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 12rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
  background: #fffaf6;
}

.result-row.self {
  background: #fdeede;
  box-shadow: inset 0 0 0 1rpx rgba(228, 155, 115, 0.4);
}

.result-no {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.result-no.medal-1 {
  background: #f6c177;
  color: #7c4a03;
}

.result-no.medal-2 {
  background: #cbd5e1;
  color: #475569;
}

.result-no.medal-3 {
  background: #e7b08a;
  color: #7c3a13;
}

.result-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #eee;
  flex-shrink: 0;
}

.result-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e49b73;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.result-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.host-tag,
.self-tag {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  vertical-align: middle;
}

.host-tag {
  background: #fde68a;
  color: #92400e;
}

.self-tag {
  background: #e49b73;
  color: #fff;
}

.result-score {
  text-align: right;
  min-width: 90rpx;
}

.score-num {
  font-size: 38rpx;
  font-weight: 800;
  color: #1f2937;
}

.score-diff {
  font-size: 22rpx;
  color: #9ca3af;
}

.fee-note {
  text-align: center;
  color: #9ca3af;
  font-size: 25rpx;
  margin: 8rpx 0 24rpx;
}

/* ===== 回合战况矩阵 ===== */
.matrix-card {
  background: #ffffff;
}

.matrix-card .card-title {
  text-align: center;
}

.matrix-scroll {
  width: 100%;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.matrix {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: max-content;
}

.matrix-row {
  display: flex;
  align-items: stretch;
  justify-content: center;
}

.matrix-cell {
  box-sizing: border-box;
  font-size: 26rpx;
  text-align: center;
}

.matrix-head {
  position: sticky;
  top: 0;
  z-index: 2;
}

.matrix-head-cell {
  width: 104rpx;
  padding: 8rpx 6rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.matrix-cell.corner {
  width: 90rpx;
  padding-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #b0a89c;
  line-height: 1.2;
  text-align: center;
}

.m-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.matrix-head-cell.self .m-avatar {
  box-shadow: 0 0 0 3rpx #e49b73;
}

.m-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e49b73;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.round-label {
  position: sticky;
  left: 0;
  z-index: 1;
  width: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #b0a89c;
  font-weight: 500;
  font-size: 24rpx;
}

.matrix-row:not(.matrix-head) {
  border-top: 1rpx solid #f5eee7;
}

.matrix-row.total-row {
  border-top: 1rpx solid #f0d9cb;
  background: #fffaf6;
}

.matrix-row.total-row .round-label {
  font-weight: 700;
  color: #b08968;
}

.matrix-row.total-row .m-score {
  font-weight: 700;
  font-size: 30rpx;
}

.m-score {
  width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 30rpx;
  color: #c9c2b8;
  padding: 24rpx 4rpx;
}

.m-score.pos {
  color: #e25560;
}

.m-score.neg {
  color: #2fa94e;
}

.m-score.zero {
  color: #d8d2c8;
}

/* 矩阵中与玩家并列的台费列：固定宽度 + 左侧虚线分隔，整行可直接看到无需滑动 */
.fee-col-head {
  width: 132rpx;
  color: #b45309;
  font-weight: 700;
  margin-left: 12rpx;
  padding-left: 8rpx;
  border-left: 1rpx dashed #e7d3c4;
}

.fee-col {
  width: 132rpx;
  color: #b45309;
  font-weight: 600;
  margin-left: 12rpx;
  padding-left: 8rpx;
  border-left: 1rpx dashed #e7d3c4;
  background: #fdf8f2;
}

.share-btn {
  width: 100%;
  height: 92rpx;
  background: #e49b73;
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  line-height: 1.2;
}

.share-btn::after {
  border: none;
}

.home-btn {
  width: 100%;
  height: 92rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
