<view class="container result-page">
  <view wx:if="{{error}}" class="error-text">{{error}}</view>

  <block wx:else>
    <view class="result-header">
      <view class="result-title">{{title || '麻将房'}} · 最终战绩</view>
      <view class="result-room">房间号 {{roomId}}</view>
    </view>

    <view wx:if="{{bestName}}" class="best-banner">
      <view class="best-label">本局最大赢家</view>
      <view class="best-name">{{bestName}}</view>
      <view class="best-score">{{bestScore}} 分</view>
    </view>

    <view class="card">
      <view wx:for="{{ranking}}" wx:key="openid" class="result-row {{item.isSelf?'self':''}}">
        <view class="result-no {{item.medal}}">{{index + 1}}</view>
        <image wx:if="{{item.avatarUrl}}" class="result-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
        <view wx:else class="result-avatar fallback">{{item.initial}}</view>
        <view class="result-name">
          {{item.nickname}}
          <text wx:if="{{item.isHost}}" class="host-tag">房主</text>
          <text wx:if="{{item.isSelf}}" class="self-tag">我</text>
        </view>
        <view class="result-score">
          <view class="score-num">{{item.totalScore}}</view>
          <view wx:if="{{item.diff>0}}" class="score-diff">落后 {{item.diff}}</view>
        </view>
      </view>
    </view>

    <view class="card matrix-card" wx:if="{{matrixRows.length > 0}}">
      <view class="card-title">回合战况</view>
      <scroll-view scroll-x class="matrix-scroll" enhanced show-scrollbar="{{false}}">
        <view class="matrix">
          <view class="matrix-row matrix-head">
            <view class="matrix-cell corner">回合</view>
            <view wx:for="{{players}}" wx:key="openid" class="matrix-cell matrix-head-cell {{item.isSelf ? 'self' : ''}}">
              <image wx:if="{{item.avatarUrl}}" class="m-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="m-avatar fallback">{{item.initial}}</view>
            </view>
            <view wx:if="{{tableFeeEnabled}}" class="matrix-cell matrix-head-cell fee-col-head">台费</view>
          </view>
          <view wx:for="{{matrixRows}}" wx:key="roundLabel" class="matrix-row {{item.isTotal ? 'total-row' : ''}}">
            <view class="matrix-cell round-label">{{item.roundLabel}}</view>
            <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="index" class="matrix-cell m-score {{cell.positive ? 'pos' : ''}} {{cell.negative ? 'neg' : ''}} {{cell.zero ? 'zero' : ''}}">{{cell.deltaText}}</view>
            <view wx:if="{{tableFeeEnabled}}" class="matrix-cell m-score fee-col {{item.feeCell.positive ? 'pos' : ''}} {{item.feeCell.zero ? 'zero' : ''}}">{{item.feeCell.deltaText}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <view wx:if="{{tableFeeEnabled}}" class="fee-note">本局已计入台费</view>

    <button class="share-btn" open-type="share">分享战绩给牌友</button>
    <view class="primary-btn home-btn" bindtap="backHome">返回首页</view>
  </block>
</view>
