.title{font-size:30rpx;font-weight:600;margin-bottom:12rpx;color:#2f5d88}
.rank-card{background:#ecf5ff}
.detail-card{background:#fff9f1}
.share-card{background:#f3fff8}
.rank-row,.log-row{display:flex;justify-content:space-between;padding:10rpx 0;border-bottom:1rpx solid #edf4fb}
.delta{color:#2f7ac9}
.round-block{background:#ffffff;border:1rpx solid #f5e3d3;border-radius:12rpx;padding:12rpx;margin-bottom:12rpx}
.round-title{color:#9c6b3b;font-weight:600;margin-bottom:6rpx}
.btn-row{display:flex;flex-direction:column;gap:12rpx}
.btn-row button{font-size:28rpx}
.poster-canvas{position:fixed;left:-9999rpx;top:-9999rpx;opacity:0}
