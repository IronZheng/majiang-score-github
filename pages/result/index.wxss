.title {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
  color: #1f2937;
}

.stats-card {
  background: #ffffff;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  background: #fffaf6;
  border-radius: 18rpx;
  padding: 16rpx 14rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.stat-label {
  color: #9ca3af;
  font-size: 24rpx;
  font-weight: 600;
}

.stat-value {
  color: #1f2937;
  font-size: 30rpx;
  font-weight: 800;
}

.stat-value.highlight {
  color: #c66d61;
}

.chart-section {
  margin-top: 8rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #6b7280;
  margin-bottom: 12rpx;
}

.stats-chart-canvas {
  width: 670rpx;
  border-radius: 16rpx;
  background: #ffffff;
}

.chart-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.legend-item {
  font-size: 24rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.legend-color-0 { background: #fff1e8; color: #e49b73; }
.legend-color-1 { background: #edf7ef; color: #5f8f6a; }
.legend-color-2 { background: #edf1fc; color: #6b8fcf; }
.legend-color-3 { background: #fff0ee; color: #c66d61; }
.legend-color-4 { background: #f3f0fc; color: #8a7bd6; }
.legend-color-5 { background: #fff8e8; color: #d4a900; }
.legend-color-6 { background: #eaf7f9; color: #4dacb8; }
.legend-color-7 { background: #fcf0f8; color: #c98fba; }

.rank-card {
  background: #e49b73;
  color: #ffffff;
  border: none;
  box-shadow: 0 18rpx 40rpx rgba(228, 155, 115, 0.20);
}

.rank-card .title {
  color: #ffffff;
}

.detail-card,
.table-fee-card,
.share-card {
  background: #ffffff;
}

.table-fee-total {
  min-height: 82rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #fffaf6;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  color: #374151;
  font-size: 30rpx;
  font-weight: 700;
}

.table-fee-total text:last-child {
  color: #b86142;
  font-size: 36rpx;
  font-weight: 900;
}

.rank-row,
.log-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  gap: 20rpx;
}

.rank-row:last-child,
.log-row:last-child {
  border-bottom: none;
}

.rank-row text:first-child,
.log-row text:first-child {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-row text:last-child {
  font-size: 36rpx;
  font-weight: 800;
}

.detail-card .log-row {
  border-bottom-color: #eef0f3;
}

.log-user {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.log-avatar {
  width: 34rpx;
  height: 34rpx;
  border-radius: 10rpx;
  border: 1rpx solid #f0d9cb;
  flex-shrink: 0;
}

.log-name {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.delta {
  flex: none;
  color: #1f2937;
  font-weight: 800;
}

.round-block {
  background: #fffaf6;
  border-radius: 16rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 12rpx;
}

.round-title {
  color: #6b7280;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.btn-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.btn-row button {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  padding: 0;
}

.poster-canvas {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  opacity: 0;
}
