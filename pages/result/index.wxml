<view class="container" wx:if="{{record}}">
  <view class="card rank-card">
    <view class="title">🏆 最终排名（共{{record.totalRounds || 1}}回合）</view>
    <block wx:for="{{record.ranking}}" wx:key="id" wx:for-item="rankPlayer" wx:for-index="rIndex">
      <view class="rank-row">
        <text>{{medals[rIndex] || ('第' + (rIndex+1) + '名')}} {{rankPlayer.name}}</text>
        <text>{{rankPlayer.score}} 分</text>
      </view>
    </block>
  </view>

  <view class="card table-fee-card" wx:if="{{record.tableFee && record.tableFee.enabled}}">
    <view class="title">台费统计</view>
    <view class="table-fee-total">
      <text>累计台费</text>
      <text>{{record.tableFee.score}} 分</text>
    </view>
  </view>

  <!-- 对局统计 -->
  <view class="card stats-card" wx:if="{{stats}}">
    <view class="title">📊 对局统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-label">胜负分差</text>
        <text class="stat-value">{{stats.gap}}分</text>
      </view>
      <view class="stat-item" wx:if="{{stats.bestRound}}">
        <text class="stat-label">手气最佳</text>
        <text class="stat-value highlight">{{stats.bestRound.playerName}} +{{stats.bestRound.delta}}</text>
      </view>
      <view class="stat-item" wx:if="{{stats.mostStable}}">
        <text class="stat-label">最稳选手</text>
        <text class="stat-value">{{stats.mostStable.name}}</text>
      </view>
    </view>
    <!-- 折线图 -->
    <view class="chart-section" wx:if="{{stats.trendSeries.length}}">
      <view class="chart-title">分数走势</view>
      <canvas
        canvas-id="statsCanvas"
        class="stats-chart-canvas"
        style="width: 670rpx; height: {{chartTotalHeight || 420}}rpx;"
      ></canvas>
      <view class="chart-legend" wx:if="{{stats.trendSeries.length > 4}}">
        <block wx:for="{{stats.trendSeries}}" wx:key="name" wx:for-item="series" wx:for-index="si">
          <view class="legend-item legend-color-{{si % 8}}">{{series.name}}</view>
        </block>
      </view>
    </view>
  </view>

  <view class="card detail-card">
    <view class="title">📒 每轮得分详情</view>
    <block wx:for="{{roundList}}" wx:key="round" wx:for-item="roundItem">
      <view class="round-block">
        <view class="round-title">第{{roundItem.round}}回合</view>
        <block wx:for="{{roundItem.scores}}" wx:key="at" wx:for-item="scoreItem">
          <view class="log-row">
            <view class="log-user">
              <image class="log-avatar" src="{{scoreItem.playerAvatar}}" mode="aspectFill"></image>
              <text class="log-name">{{scoreItem.playerName}}</text>
            </view>
            <text class="delta">{{scoreItem.delta > 0 ? '+' : ''}}{{scoreItem.delta}}</text>
          </view>
        </block>
      </view>
    </block>
  </view>

  <view class="card share-card">
    <view class="btn-row">
      <button class="primary-btn" open-type="share">分享给好友</button>
      <button class="secondary-btn" bindtap="previewPoster">预览战绩图</button>
      <button class="secondary-btn" bindtap="savePoster">保存战绩图</button>
    </view>
  </view>

  <canvas
    canvas-id="posterCanvas"
    class="poster-canvas"
    width="690"
    height="{{posterHeight}}"
    style="width: 690px; height: {{posterHeight}}px;"
  ></canvas>
</view>
