.setup-page {
  font-size: 30rpx;
}

.add-my-guide {
  position: relative;
  min-height: 116rpx;
  margin: 0 0 24rpx;
  padding: 22rpx 72rpx 22rpx 22rpx;
  border: 1rpx solid rgba(228, 155, 115, 0.18);
  border-radius: 22rpx;
  background: #fff4ed;
  box-shadow: 0 12rpx 30rpx rgba(228, 155, 115, 0.12);
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.guide-arrow {
  position: absolute;
  top: -14rpx;
  right: 78rpx;
  width: 26rpx;
  height: 26rpx;
  background: #fff4ed;
  border-top: 1rpx solid rgba(228, 155, 115, 0.18);
  border-left: 1rpx solid rgba(228, 155, 115, 0.18);
  transform: rotate(45deg);
}

.guide-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #e49b73;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 500;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 8rpx 18rpx rgba(228, 155, 115, 0.22);
}

.guide-copy {
  flex: 1;
  min-width: 0;
}

.guide-title {
  color: #8f4f31;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.guide-desc {
  margin-top: 6rpx;
  color: #9a6a54;
  font-size: 24rpx;
  line-height: 1.5;
}

.guide-close {
  position: absolute;
  top: 12rpx;
  right: 14rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  color: #b98b74;
  font-size: 38rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-close:active {
  background: rgba(228, 155, 115, 0.12);
}

.header-card {
  min-height: 168rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  background: #e49b73;
  color: #ffffff;
  border: none;
  box-shadow: 0 18rpx 40rpx rgba(228, 155, 115, 0.20);
}

.count-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.64);
  margin-bottom: 8rpx;
}

.count-badge {
  font-size: 54rpx;
  line-height: 1;
  font-weight: 800;
  color: #ffffff;
}

.title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
  color: #1f2937;
}

.warm,
.cool {
  background: #ffffff;
}

.count-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.count-btn {
  min-width: 0;
  height: 84rpx;
  background: #f3f4f6;
  color: #4b5563;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.count-btn.active {
  background: #e49b73;
  color: #ffffff;
}

.add-btn {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.success-btn {
  background: #eef2f6;
  color: #1f2937;
  border-radius: 16rpx;
  font-weight: 700;
}

.start-btn {
  width: 100%;
  height: 96rpx;
  margin: 6rpx 0 32rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 92rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.player-row:last-child {
  border-bottom: none;
}

.player-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #fff6f0;
  border: 1rpx solid #f0d9cb;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.player-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.name-input {
  flex: 1;
  min-width: 0;
  height: 76rpx;
  background: #fffaf6;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  padding: 0 22rpx;
  font-size: 32rpx;
  color: #1f2937;
  box-sizing: border-box;
}

.btn-clear,
.btn-del {
  padding: 14rpx 18rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
}

.btn-clear {
  background: #f3f4f6;
  color: #6b7280;
}

.btn-del {
  background: #fff1f2;
  color: #e11d48;
}

.fee-card {
  background: #ffffff;
  transition: opacity 0.2s ease;
}

.fee-card.fee-disabled {
  background: #f8f9fb;
}

.fee-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.fee-title {
  margin-bottom: 8rpx;
}

.fee-subtitle {
  color: #6b7280;
  font-size: 25rpx;
  line-height: 1.45;
}

.fee-check-group {
  flex-shrink: 0;
}

.fee-check {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

