.setup-page{font-size:30rpx}
.header-card{background:linear-gradient(135deg,#eaf4ff,#d8eafe);display:flex;align-items:center;justify-content:space-between}
.count-title{font-size:34rpx;color:#436b93}
.count-badge{font-size:44rpx;font-weight:700;color:#1e5fa3}
.title { font-size: 34rpx; font-weight: 700; margin-bottom: 18rpx; color: #2f5d88; }
.warm { background: #fff8ef; }
.cool { background: #f2f8ff; }
.count-grid { display: flex; gap: 16rpx; margin-bottom: 16rpx; }
.count-btn { flex: 1; background: #fff; color: #915a11; border: 1rpx solid #ffd9a5; border-radius: 12rpx; font-size:30rpx }
.count-btn.active { background: #ffb347; color: #fff; border-color: #ffb347; }
.add-btn{width:100%;font-size:30rpx}
.success-btn { background: #e1f7ed; color: #2d9b63; border: 1rpx solid #bcecd3; border-radius: 12rpx; }
.player-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.player-avatar { width: 70rpx; height: 70rpx; border-radius: 50%; background: #d3e9ff; display: flex; align-items: center; justify-content: center; font-size: 40rpx; }
.name-input { flex:1; background: #ffffff; border: 1rpx solid #d6e8f8; border-radius: 12rpx; padding: 20rpx 20rpx; font-size:34rpx }
.btn-clear{padding:16rpx 20rpx;background:#e8f4ff;color:#2f7ac9;border-radius:12rpx;font-size:28rpx}
.btn-del{padding:16rpx 20rpx;background:#ffeded;color:#e64343;border-radius:12rpx;font-size:28rpx}
