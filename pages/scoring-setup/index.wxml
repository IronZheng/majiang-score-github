<view class="container setup-page">
  <view class="add-my-guide" wx:if="{{showAddMyGuide}}">
    <view class="guide-arrow"></view>
    <view class="guide-icon">+</view>
    <view class="guide-copy">
      <view class="guide-title">喜欢这个小程序？把它留下吧</view>
      <view class="guide-desc">点右上角「···」，选择「添加到我的小程序」，下次开局不迷路</view>
    </view>
    <view class="guide-close" catchtap="dismissAddMyGuide" role="button" aria-label="关闭提示">×</view>
  </view>

  <view class="mode-switch">
    <view class="mode-item {{mode==='single'?'active':''}}" data-mode="single" bindtap="setMode">单人记账</view>
    <view class="mode-item {{mode==='multi'?'active':''}}" data-mode="multi" bindtap="setMode">多人房间</view>
  </view>

  <view class="card header-card">
    <view class="count-title">当前人数</view>
    <view class="count-badge">{{playerCount}} 人局</view>
  </view>

  <view class="card warm">
    <view class="title">预设人数</view>
    <view class="count-grid">
      <block wx:for="{{presetCounts}}" wx:key="*this">
        <view class="count-btn {{playerCount===item?'active':''}}" data-count="{{item}}" bindtap="setPresetCount">{{item}}人</view>
      </block>
    </view>
    <view class="success-btn add-btn" bindtap="addPlayer">+ 添加玩家</view>
  </view>

  <view class="card cool">
    <view class="title">玩家信息</view>
    <block wx:for="{{players}}" wx:key="id">
        <view class="player-row">
          <view class="player-avatar">
          <image class="player-avatar-img" src="{{item.avatarUrl || avatars[index % avatars.length]}}" mode="aspectFill"></image>
        </view>
        <input class="name-input" value="{{item.name}}" data-index="{{index}}" bindinput="onNameChange" mut-bind:blur="onNameBlur" placeholder="请输入名字" />
        <text class="btn-clear" data-index="{{index}}" catchtap="clearName">清空</text>
        <text class="btn-del" data-index="{{index}}" catchtap="removePlayer">删除</text>
      </view>
    </block>
  </view>

  <view class="card fee-card {{tableFeeEnabled ? '' : 'fee-disabled'}}">
    <view class="fee-top">
      <view>
        <view class="title fee-title">台费</view>
        <view class="fee-subtitle">勾选后计分页会显示独立台费栏目</view>
      </view>
      <checkbox-group class="fee-check-group" bindchange="onTableFeeChange">
        <label class="fee-check">
          <checkbox value="enabled" checked="{{tableFeeEnabled}}" color="#e49b73" />
        </label>
      </checkbox-group>
    </view>
  </view>

  <view class="primary-btn start-btn" bindtap="startGame">开始计分</view>
</view>
