.container {
  min-height: 100vh;
  padding: 48rpx 36rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fffaf6 0%, #fdeee2 100%);
}

.hero {
  margin-top: 60rpx;
  margin-bottom: 64rpx;
  text-align: center;
}

.hero-title {
  font-size: 60rpx;
  font-weight: 900;
  color: #8a3f24;
  letter-spacing: 4rpx;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 30rpx;
  color: #b07a5e;
  font-weight: 700;
}

.hero-rules {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #b8917e;
  line-height: 1.6;
}

.menu {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  padding: 36rpx 30rpx;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(150, 100, 70, 0.12);
  border: 2rpx solid #f3e2d4;
}

.menu-card.primary {
  background: linear-gradient(145deg, #b95f3a 0%, #d87e53 48%, #e9a17b 100%);
  border-color: transparent;
}

.menu-icon {
  font-size: 64rpx;
  margin-right: 28rpx;
}

.menu-main {
  flex: 1;
}

.menu-name {
  font-size: 36rpx;
  font-weight: 900;
  color: #5a2c18;
}

.menu-card.primary .menu-name {
  color: #fff;
}

.menu-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9a6f58;
}

.menu-card.primary .menu-desc {
  color: rgba(255, 255, 255, 0.9);
}

.menu-arrow {
  font-size: 48rpx;
  color: #cbb3a3;
  font-weight: 900;
}

.menu-card.primary .menu-arrow {
  color: rgba(255, 255, 255, 0.9);
}
