<view class="container">
  <view class="hero">
    <view class="hero-title">牌技挑战</view>
    <view class="hero-sub">听牌闯关 · 共 50 关</view>
    <view class="hero-rules">3 条命 · 整场限时 1 分钟 · 积分越高排名越高</view>
  </view>

  <view class="menu">
    <view class="menu-card primary" bindtap="goChallenge">
      <view class="menu-icon">🀄</view>
      <view class="menu-main">
        <view class="menu-name">听牌挑战</view>
        <view class="menu-desc">逐关作答，答错扣 1 命，时间到结束</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>

    <view class="menu-card" bindtap="goLeaderboard">
      <view class="menu-icon">🏆</view>
      <view class="menu-main">
        <view class="menu-name">排行榜</view>
        <view class="menu-desc">看看谁是麻将听牌大师</view>
      </view>
      <view class="menu-arrow">›</view>
    </view>
  </view>
</view>
