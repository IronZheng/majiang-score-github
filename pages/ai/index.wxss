.container {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 30rpx 28rpx 156rpx;
  background: #fffaf6;
}

.hero {
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx 32rpx;
  border-radius: 18rpx;
  background: #e49b73;
  color: #ffffff;
  box-shadow: 0 18rpx 40rpx rgba(228, 155, 115, 0.20);
}

.eyebrow {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.72);
}

.title {
  font-size: 40rpx;
  line-height: 1.28;
  font-weight: 800;
  color: #ffffff;
}

.subtitle {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 25rpx;
  line-height: 1.5;
}

.upload-panel,
.input-panel,
.response-section,
.tips-section {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.12);
  box-shadow: 0 12rpx 30rpx rgba(120, 88, 64, 0.07);
}

.panel-head {
  margin-bottom: 18rpx;
}

.section-title,
.tips-title {
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 800;
  color: #263238;
}

.section-note {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: #7f8a96;
}

.upload-area {
  display: flex;
  min-height: 312rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #f0d9cb;
  border-radius: 16rpx;
  background: #fffaf6;
}

.camera-mark {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background: #e49b73;
  color: #ffffff;
  font-size: 36rpx;
  font-weight: 800;
}

.upload-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #2d3a45;
}

.upload-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9c8a7b;
}

.image-preview {
  position: relative;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f6f1eb;
}

.preview-image {
  display: block;
  width: 100%;
  height: 420rpx;
}

.remove-image {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  min-width: 112rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(31, 41, 55, 0.78);
  color: #ffffff;
  font-size: 24rpx;
  line-height: 56rpx;
}

.remove-image::after {
  border: 0;
}

.input-box {
  width: 100%;
  min-height: 168rpx;
  box-sizing: border-box;
  padding: 20rpx;
  border: 2rpx solid #e6edf3;
  border-radius: 14rpx;
  background: #fffaf6;
  color: #2d3a45;
  font-size: 28rpx;
  line-height: 1.6;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.analyze-btn,
.clear-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  box-sizing: border-box;
  padding: 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1;
}

.analyze-btn {
  flex: 1;
  background: #e49b73;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(228, 155, 115, 0.20);
}

.clear-btn {
  width: 156rpx;
  background: #ffffff;
  color: #6b7280;
  border: 2rpx solid #f0d9cb;
}

.analyze-btn::after,
.clear-btn::after {
  border: 0;
}

.is-disabled {
  opacity: 0.62;
}

.loading-section {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 28rpx;
  color: #b86142;
}

.loading-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #e49b73;
  animation: pulse 1.1s ease-in-out infinite;
}

.loading-text {
  font-size: 26rpx;
}

.response-box {
  margin-top: 18rpx;
  padding: 24rpx;
  border-left: 6rpx solid #e49b73;
  border-radius: 14rpx;
  background: #fffaf6;
}

.response-text {
  color: #263238;
  font-size: 28rpx;
  line-height: 1.8;
  word-break: break-word;
  white-space: pre-wrap;
}

.tips-section {
  margin-bottom: 0;
}

.tip-item {
  margin-top: 14rpx;
  color: #667483;
  font-size: 25rpx;
  line-height: 1.55;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(0.8);
    opacity: 0.45;
  }
  50% {
    transform: scale(1.15);
    opacity: 1;
  }
}
