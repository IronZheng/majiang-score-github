.board-page {
  font-size: 30rpx;
}

.error-text {
  text-align: center;
  color: #ef4444;
  padding: 60rpx 20rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.room-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2937;
}

.room-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.top-actions {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
}

.icon-btn {
  height: 64rpx;
  padding: 0 26rpx;
  background: #e49b73;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn.ghost {
  background: #f3f4f6;
  color: #6b7280;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
  color: #1f2937;
}

.empty {
  color: #9ca3af;
  font-size: 26rpx;
  text-align: center;
  padding: 20rpx 0;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: #fffaf6;
}

.rank-row.self {
  background: #fdeede;
  box-shadow: inset 0 0 0 1rpx rgba(228, 155, 115, 0.4);
}

.rank-row.leader {
  background: linear-gradient(135deg, #fff3e6, #ffe6cf);
  box-shadow: inset 0 0 0 1rpx rgba(224, 123, 69, 0.5);
}

.rank-row.last {
  background: #f4f6f8;
  opacity: 0.92;
}

.rank-no {
  width: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #e49b73;
}

.rank-no-1 {
  color: #e07b45;
  font-size: 34rpx;
}

/* 第一名皇冠：放在名字右边 */
.crown-tag {
  margin-left: 20rpx;
  font-size: 30rpx;
  line-height: 1;
  filter: drop-shadow(0 2rpx 2rpx rgba(224, 123, 69, 0.35));
}

.rank-no-2 {
  color: #c08457;
}

.rank-no-3 {
  color: #b08968;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #eee;
  flex-shrink: 0;
}

.rank-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e49b73;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.rank-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.host-tag,
.self-tag {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  vertical-align: middle;
}

.host-tag {
  background: #fde68a;
  color: #92400e;
}

.self-tag {
  background: #e49b73;
  color: #fff;
}

.rank-score {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2937;
  min-width: 80rpx;
  text-align: right;
}

/* 红涨绿跌：正分红色、负分绿色、零分灰 */
.rank-score.pos {
  color: #e25560;
}

.rank-score.neg {
  color: #2fa94e;
}

.rank-score.zero {
  color: #9ca3af;
}

/* ===== 等待：玩家列表加人 ===== */
.title-warn {
  color: #ef4444;
  font-size: 24rpx;
  font-weight: 600;
  margin-left: 6rpx;
}

.add-chip {
  background: #fff4ed;
  border: 2rpx dashed #e49b73;
  cursor: pointer;
}

.add-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #e49b73;
  color: #fff;
  font-size: 44rpx;
  font-weight: 300;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-text {
  max-width: 124rpx;
  font-size: 24rpx;
  color: #c0743f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.add-chip:active {
  opacity: 0.7;
}

/* ===== 进行中：按圈记分 ===== */
.score-form {
  background: #ffffff;
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

.form-sum {
  font-size: 26rpx;
  font-weight: 700;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.form-sum.ok {
  background: #eafaef;
  color: #34a853;
}

.form-sum.bad {
  background: #fdecec;
  color: #ef4444;
}

.score-rows {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.score-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fffaf6;
  border: 1rpx solid rgba(228, 155, 115, 0.14);
  box-sizing: border-box;
}

.row-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.row-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e49b73;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.row-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-toggle {
  position: relative;
  width: 152rpx;
  height: 76rpx;
  border-radius: 999rpx;
  background: #f7ece3;
  border: 1rpx solid rgba(228, 155, 115, 0.28);
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  box-shadow: inset 0 1rpx 3rpx rgba(120, 88, 64, 0.12);
}

.row-toggle:active {
  opacity: 0.92;
}

.toggle-thumb {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: calc(50% - 4rpx);
  height: calc(100% - 8rpx);
  border-radius: 999rpx;
  z-index: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  transition: transform 0.32s cubic-bezier(0.34, 1.56, 0.64, 1), background 0.32s ease;
}

/* ＋ 赢/涨 = 红；－ 输/跌 = 绿（红涨绿跌） */
.row-toggle.plus .toggle-thumb {
  transform: translateX(0);
  background: linear-gradient(135deg, #f0808a, #e25560);
}

.row-toggle.minus .toggle-thumb {
  transform: translateX(100%);
  background: linear-gradient(135deg, #43c463, #2fa94e);
}

.toggle-opt {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 300;
  line-height: 1;
  transition: color 0.32s ease;
}

.row-toggle.plus .plus-opt {
  color: #ffffff;
}

.row-toggle.plus .minus-opt {
  color: #b08968;
}

.row-toggle.minus .plus-opt {
  color: #b08968;
}

.row-toggle.minus .minus-opt {
  color: #ffffff;
}

.row-input {
  width: 180rpx;
  height: 76rpx;
  background: #ffffff;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #1f2937;
  box-sizing: border-box;
  flex-shrink: 0;
}

.auto-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #2fa94e;
  background: #eafaef;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

/* 每圈台费输入（正数，可改） */
.fee-input-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fff7f0;
  border: 1rpx solid rgba(228, 155, 115, 0.22);
  box-sizing: border-box;
}

.fee-label {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #b45309;
}

.fee-input {
  width: 180rpx;
  height: 76rpx;
  background: #ffffff;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
  color: #1f2937;
  box-sizing: border-box;
  flex-shrink: 0;
}

.round-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.round-actions .ghost-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 16rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.round-actions .ghost-btn:active {
  opacity: 0.7;
}

.round-actions .primary-btn {
  flex: 2;
  height: 92rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
  background: linear-gradient(135deg, #f0a070, #e07b45);
  border-radius: 16rpx;
  box-shadow: 0 14rpx 30rpx rgba(224, 123, 69, 0.28);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.round-actions .primary-btn.disabled {
  background: #d9c3b4;
  box-shadow: none;
}

.round-actions .primary-btn:active {
  transform: scale(0.99);
  opacity: 0.92;
}

.host-bar {
  margin: 8rpx 0 24rpx;
}

.host-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-btn.disabled {
  background: #d9c3b4;
  box-shadow: none;
}

.host-btn.ghost-end {
  background: #f3f4f6;
  color: #b45309;
  box-shadow: none;
}

.feed-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 26rpx;
}

.feed-row:last-child {
  border-bottom: none;
}

.feed-name {
  flex: 1;
  min-width: 0;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-round {
  color: #9ca3af;
}

.feed-delta {
  font-weight: 800;
}

.feed-delta.pos {
  color: #34a853;
}

.feed-delta.neg {
  color: #ef4444;
}

.feed-time {
  color: #9ca3af;
  font-size: 24rpx;
}

/* ===== 回合战况矩阵 ===== */
.matrix-card {
  background: #ffffff;
}

.matrix-card .card-title {
  text-align: center;
}

.matrix-scroll {
  width: 100%;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
}

.matrix {
  display: flex;
  flex-direction: column;
  width: 100%;
  min-width: max-content;
}

.matrix-row {
  display: flex;
  align-items: stretch;
  justify-content: center;
}

.matrix-cell {
  box-sizing: border-box;
  font-size: 26rpx;
  text-align: center;
}

.matrix-head {
  position: sticky;
  top: 0;
  z-index: 2;
}

.matrix-head-cell {
  width: 104rpx;
  padding: 8rpx 6rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

/* 表头首格：与头像同行的"回合战况"标题，与数据行首列等宽保证对齐 */
.matrix-cell.corner {
  width: 90rpx;
  padding-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #b0a89c;
  line-height: 1.2;
  text-align: center;
}

.m-avatar {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: #eee;
  flex-shrink: 0;
}

.matrix-head-cell.self .m-avatar {
  box-shadow: 0 0 0 3rpx #e49b73;
}

.m-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e49b73;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.round-label {
  position: sticky;
  left: 0;
  z-index: 1;
  width: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: #b0a89c;
  font-weight: 500;
  font-size: 24rpx;
}

.matrix-row:not(.matrix-head) {
  border-top: 1rpx solid #f5eee7;
}

.m-score {
  width: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 30rpx;
  color: #c9c2b8;
  padding: 24rpx 4rpx;
}

.m-score.pos {
  color: #e25560;
}

.m-score.neg {
  color: #2fa94e;
}

.m-score.zero {
  color: #d8d2c8;
}

/* 邀请面板（与 room-create 一致） */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  z-index: 50;
}

.invite-card {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.invite-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.invite-room {
  font-size: 30rpx;
  color: #374151;
  margin-bottom: 24rpx;
}

.copy {
  color: #e49b73;
  font-weight: 700;
  margin-left: 12rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  background: #e49b73;
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  line-height: 1.2;
}

.share-btn::after {
  border: none;
}

.qrcode-img {
  width: 360rpx;
  height: 360rpx;
  margin: 8rpx auto 0;
  display: block;
  background: #fff;
  border-radius: 16rpx;
}

.qrcode-tip {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 40rpx 0;
}

.invite-close {
  margin-top: 24rpx;
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 600;
}

/* ===== 二维码卡片（房间内直显） ===== */
.qrcode-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.qrcode-left {
  flex: 1;
  min-width: 0;
}

.qr-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.qr-room {
  font-size: 24rpx;
  color: #9ca3af;
  margin-bottom: 18rpx;
}

.qrcode-card .qrcode-img {
  width: 200rpx;
  height: 200rpx;
  margin: 0;
  flex-shrink: 0;
}

.qrcode-card .qrcode-tip {
  width: 200rpx;
  padding: 0;
  text-align: center;
  flex-shrink: 0;
}

.qrcode-card .share-btn {
  height: 72rpx;
  font-size: 26rpx;
  margin-bottom: 0;
}

/* ===== 玩家横向列表 ===== */
.player-scroll {
  white-space: nowrap;
  width: 100%;
}

.player-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  width: 140rpx;
  padding: 16rpx 8rpx;
  margin-right: 14rpx;
  border-radius: 18rpx;
  background: #fffaf6;
  border: 2rpx solid transparent;
  box-sizing: border-box;
  vertical-align: top;
}

.player-chip.active {
  border-color: #e07b45;
  background: #fdeede;
  box-shadow: 0 8rpx 18rpx rgba(224, 123, 69, 0.2);
}

.chip-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #eee;
}

.chip-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e49b73;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}

.chip-name {
  max-width: 124rpx;
  font-size: 24rpx;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.chip-name .host-tag {
  margin-left: 4rpx;
  padding: 0 8rpx;
  font-size: 18rpx;
}

.chip-score {
  font-size: 32rpx;
  font-weight: 800;
  color: #1f2937;
}

/* 矩阵中与玩家并列的台费列：固定宽度 + 左侧虚线分隔，整行可直接看到无需滑动 */
.fee-col-head {
  width: 132rpx;
  color: #b45309;
  font-weight: 700;
  margin-left: 12rpx;
  padding-left: 8rpx;
  border-left: 1rpx dashed #e7d3c4;
}

.fee-col {
  width: 132rpx;
  color: #b45309;
  font-weight: 600;
  margin-left: 12rpx;
  padding-left: 8rpx;
  border-left: 1rpx dashed #e7d3c4;
  background: #fdf8f2;
}
