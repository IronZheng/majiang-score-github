.board-page {
  font-size: 30rpx;
}

.error-text {
  text-align: center;
  color: #ef4444;
  padding: 60rpx 20rpx;
}

.top-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.room-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2937;
}

.room-meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #9ca3af;
}

.top-actions {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
}

.icon-btn {
  height: 64rpx;
  padding: 0 26rpx;
  background: #e49b73;
  color: #fff;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-btn.ghost {
  background: #f3f4f6;
  color: #6b7280;
}

.card-title {
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 18rpx;
  color: #1f2937;
}

.empty {
  color: #9ca3af;
  font-size: 26rpx;
  text-align: center;
  padding: 20rpx 0;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: #fffaf6;
}

.rank-row.self {
  background: #fdeede;
  box-shadow: inset 0 0 0 1rpx rgba(228, 155, 115, 0.4);
}

.rank-no {
  width: 44rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: #e49b73;
}

.rank-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #eee;
  flex-shrink: 0;
}

.rank-avatar.fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e49b73;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}

.rank-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #1f2937;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.host-tag,
.self-tag {
  margin-left: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  vertical-align: middle;
}

.host-tag {
  background: #fde68a;
  color: #92400e;
}

.self-tag {
  background: #e49b73;
  color: #fff;
}

.rank-score {
  font-size: 36rpx;
  font-weight: 800;
  color: #1f2937;
  min-width: 80rpx;
  text-align: right;
}

.score-card {
  background: #ffffff;
}

.score-input-row {
  margin-bottom: 16rpx;
}

.score-input {
  height: 92rpx;
  background: #fffaf6;
  border: 1rpx solid #f0d9cb;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  font-weight: 700;
  text-align: center;
  box-sizing: border-box;
}

.score-btns {
  display: flex;
  gap: 18rpx;
}

.score-btn {
  flex: 1;
  height: 92rpx;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 22rpx rgba(0, 0, 0, 0.08);
}

.score-btn.win {
  background: #34a853;
}

.score-btn.lose {
  background: #ef4444;
}

.score-extra {
  display: flex;
  gap: 18rpx;
  margin-top: 16rpx;
}

.extra-input {
  flex: 1;
  height: 76rpx;
  background: #f3f4f6;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.extra-input.note {
  flex: 2;
}

.undo-link {
  margin-top: 16rpx;
  text-align: center;
  color: #6b7280;
  font-size: 26rpx;
}

.host-bar {
  margin: 8rpx 0 24rpx;
}

.host-btn {
  width: 100%;
  height: 96rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feed-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
  font-size: 26rpx;
}

.feed-row:last-child {
  border-bottom: none;
}

.feed-name {
  flex: 1;
  min-width: 0;
  color: #374151;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.feed-round {
  color: #9ca3af;
}

.feed-delta {
  font-weight: 800;
}

.feed-delta.pos {
  color: #34a853;
}

.feed-delta.neg {
  color: #ef4444;
}

.feed-time {
  color: #9ca3af;
  font-size: 24rpx;
}

/* 邀请面板（与 room-create 一致） */
.overlay {
  position: fixed;
  inset: 0;
  background: rgba(17, 24, 39, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
  z-index: 50;
}

.invite-card {
  width: 100%;
  max-width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  text-align: center;
}

.invite-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.invite-room {
  font-size: 30rpx;
  color: #374151;
  margin-bottom: 24rpx;
}

.copy {
  color: #e49b73;
  font-weight: 700;
  margin-left: 12rpx;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  background: #e49b73;
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  line-height: 1.2;
}

.share-btn::after {
  border: none;
}

.qrcode-img {
  width: 360rpx;
  height: 360rpx;
  margin: 8rpx auto 0;
  display: block;
  background: #fff;
  border-radius: 16rpx;
}

.qrcode-tip {
  font-size: 26rpx;
  color: #9ca3af;
  padding: 40rpx 0;
}

.invite-close {
  margin-top: 24rpx;
  color: #6b7280;
  font-size: 28rpx;
  font-weight: 600;
}
