<view class="container board-page">
  <view wx:if="{{error}}" class="error-text">{{error}}</view>

  <view class="top-bar" wx:else>
    <view class="top-left">
      <view class="room-title">{{title || '麻将房'}}</view>
      <view class="room-meta">房间号 {{roomId}} · {{players.length}}人 · {{statusText}}</view>
    </view>
    <view class="top-actions">
      <view class="icon-btn" bindtap="toggleInvite">邀请</view>
      <view class="icon-btn ghost" bindtap="leave">离开</view>
    </view>
  </view>

  <!-- ===== 等待中：二维码 + 玩家列表 + 开始 ===== -->
  <block wx:if="{{status === 0}}">
    <view class="card qrcode-card">
      <view class="qrcode-left">
        <view class="qr-title">扫码加入</view>
        <view class="qr-room" bindtap="copyRoomId">房间号 {{roomId}}（点击复制）</view>
        <button class="share-btn" open-type="share">分享给好友</button>
      </view>
      <image wx:if="{{qrcode}}" class="qrcode-img" src="{{qrcode}}" mode="aspectFit" bindtap="toggleInvite"></image>
      <view wx:elif="{{qrcodeLoading}}" class="qrcode-tip">二维码生成中…</view>
      <view wx:else class="qrcode-tip" bindtap="loadQrcode">点击加载二维码</view>
    </view>

    <view class="card">
      <view class="card-title">
        玩家（{{players.length}}人）
        <text wx:if="{{players.length < 2}}" class="title-warn">· 至少 2 人才能开始</text>
      </view>
      <scroll-view scroll-x class="player-scroll" wx:if="{{players.length > 0}}">
        <view wx:for="{{players}}" wx:key="openid" class="player-chip {{item.isSelf ? 'self' : ''}}">
          <image wx:if="{{item.avatarUrl}}" class="chip-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="chip-avatar fallback">{{item.initial}}</view>
          <view class="chip-name">{{item.nickname}}<text wx:if="{{item.isHost}}" class="host-tag">主</text></view>
          <view class="chip-score">{{item.totalScore}}</view>
        </view>
        <view class="player-chip add-chip" bindtap="addPlayer">
          <view class="add-ico">＋</view>
          <view class="add-text">加人</view>
        </view>
      </scroll-view>
      <view wx:else class="empty">还没有玩家，点右侧「＋」添加</view>
    </view>

    <view wx:if="{{isHost}}" class="host-bar">
      <view class="primary-btn host-btn {{players.length < 2 ? 'disabled' : ''}}" bindtap="startGame">{{players.length < 2 ? '至少 2 人开始' : '开始计分'}}</view>
    </view>
  </block>

  <!-- ===== 进行中：按圈记分 ===== -->
  <block wx:if="{{status === 1}}">
    <view class="card score-form">
      <view class="form-head">
        <view class="form-title">第 {{editingRound}} 圈 · 记分</view>
        <view wx:if="{{tableFeeEnabled}}" class="form-sum {{sumOk ? 'ok' : 'bad'}}">玩家合计 {{roundSum}} + 台费 {{tableFeeInput || 0}}，应为 0</view>
        <view wx:else class="form-sum {{sumOk ? 'ok' : 'bad'}}">合计 {{roundSum}}（需为 0）</view>
      </view>
      <view class="score-rows">
        <view class="score-row" wx:for="{{scoreRows}}" wx:key="openid">
          <image wx:if="{{item.avatarUrl}}" class="row-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="row-avatar fallback">{{item.initial}}</view>
          <view class="row-name">{{item.nickname}}<text wx:if="{{item.isHost}}" class="host-tag">主</text></view>
          <view class="row-toggle {{item.sign > 0 ? 'plus' : 'minus'}}" data-openid="{{item.openid}}" bindtap="toggleSign">
            <view class="toggle-thumb"></view>
            <text class="toggle-opt plus-opt">＋</text>
            <text class="toggle-opt minus-opt">－</text>
          </view>
          <input class="row-input" type="number" placeholder="0" value="{{item.value}}" data-openid="{{item.openid}}" bindinput="onRowInput" />
          <text wx:if="{{item.auto}}" class="auto-tag">自动</text>
        </view>
      </view>
      <view wx:if="{{tableFeeEnabled}}" class="fee-input-row">
        <text class="fee-label">台费（本圈，正数）</text>
        <input class="fee-input" type="number" placeholder="0" value="{{tableFeeInput}}" bindinput="onFeeInput" />
      </view>
      <view class="round-actions">
        <view class="ghost-btn" bindtap="resetRound">重置本回合</view>
        <view class="primary-btn {{sumOk ? '' : 'disabled'}}" bindtap="confirmRound">确定本回合</view>
      </view>
    </view>

    <view wx:if="{{isHost}}" class="host-bar">
      <view class="primary-btn host-btn ghost-end" bindtap="finishGame">结束游戏</view>
    </view>

    <!-- 实时战况：每轮结束后展示各玩家累计得分与排名 -->
    <view class="card live-rank-card" wx:if="{{ranking.length > 0}}">
      <view class="card-title">实时战况 · 当前排名</view>
      <view class="rank-list">
        <view class="rank-row {{item.isSelf ? 'self' : ''}} {{item.isLeader ? 'leader' : ''}} {{item.isLast ? 'last' : ''}}" wx:for="{{ranking}}" wx:key="openid">
          <view class="rank-no rank-no-{{item.rank}}">{{item.rank}}</view>
          <image wx:if="{{item.avatarUrl}}" class="rank-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="rank-avatar fallback">{{item.initial}}</view>
          <view class="rank-name">{{item.nickname}}<text wx:if="{{item.isSelf}}" class="self-tag">我</text><text wx:if="{{item.isLeader}}" class="crown-tag">👑</text></view>
          <view class="rank-score {{item.scorePositive ? 'pos' : ''}} {{item.scoreNegative ? 'neg' : ''}} {{item.scoreZero ? 'zero' : ''}}">{{item.totalScore > 0 ? '+' : ''}}{{item.totalScore}}分</view>
        </view>
      </view>
    </view>

    <view class="card matrix-card" wx:if="{{matrixRows.length > 0}}">
      <scroll-view scroll-x class="matrix-scroll" enhanced show-scrollbar="{{false}}">
        <view class="matrix">
          <view class="matrix-row matrix-head">
            <view class="matrix-cell corner">回合战况</view>
            <view wx:for="{{players}}" wx:key="openid" class="matrix-cell matrix-head-cell {{item.isSelf ? 'self' : ''}}">
              <image wx:if="{{item.avatarUrl}}" class="m-avatar" src="{{item.avatarUrl}}" mode="aspectFill"></image>
              <view wx:else class="m-avatar fallback">{{item.initial}}</view>
            </view>
            <view wx:if="{{tableFeeEnabled}}" class="matrix-cell matrix-head-cell fee-col-head">台费</view>
          </view>
          <view wx:for="{{matrixRows}}" wx:key="roundLabel" class="matrix-row">
            <view class="matrix-cell round-label">{{item.roundLabel}}</view>
            <view wx:for="{{item.cells}}" wx:for-item="cell" wx:key="index" class="matrix-cell m-score {{cell.positive ? 'pos' : ''}} {{cell.negative ? 'neg' : ''}} {{cell.zero ? 'zero' : ''}}">{{cell.deltaText}}</view>
            <view wx:if="{{tableFeeEnabled}}" class="matrix-cell m-score fee-col {{item.feeCell.positive ? 'pos' : ''}} {{item.feeCell.zero ? 'zero' : ''}}">{{item.feeCell.deltaText}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>
</view>

<!-- 邀请面板 -->
<view class="overlay" wx:if="{{inviteVisible}}">
  <view class="invite-card">
    <view class="invite-title">邀请好友加入</view>
    <view class="invite-room">房间号：{{roomId}} <text class="copy" bindtap="copyRoomId">复制</text></view>
    <button class="share-btn" open-type="share">分享给好友</button>
    <image wx:if="{{qrcode}}" class="qrcode-img" src="{{qrcode}}" mode="aspectFit"></image>
    <view wx:elif="{{qrcodeLoading}}" class="qrcode-tip">小程序码生成中…</view>
    <view wx:else class="qrcode-tip">小程序码暂不可用，可改用上方分享按钮</view>
    <view class="invite-close" bindtap="toggleInvite">关闭</view>
  </view>
</view>
