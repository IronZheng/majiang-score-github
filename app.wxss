page {
  padding-bottom: 132rpx;
  background: #fffaf6;
  color: #1f2937;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 30rpx;
}

.container {
  padding: 28rpx;
  box-sizing: border-box;
}

button {
  margin: 0;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border: 1rpx solid rgba(228, 155, 115, 0.11);
  border-radius: 20rpx;
  box-shadow: 0 14rpx 36rpx rgba(228, 155, 115, 0.08);
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
}

.primary-btn {
  background: #e49b73;
  color: #fff;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 28rpx rgba(228, 155, 115, 0.22);
  font-weight: 600;
  border: none;
}
.primary-btn::after {
  border: none;
}
.primary-btn:active {
  transform: scale(0.98);
  opacity: 0.86;
  box-shadow: 0 6rpx 18rpx rgba(228, 155, 115, 0.16);
}

.secondary-btn {
  background: #ffffff;
  color: #374151;
  border: 1rpx solid #d9dee7;
  border-radius: 18rpx;
  font-weight: 600;
}
.secondary-btn::after {
  border: none;
}
